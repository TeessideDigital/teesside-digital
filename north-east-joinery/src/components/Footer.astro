---
/**
 * Site footer. Restates the demo status explicitly (PROJECT_BRIEF.md
 * Section 4) because the footer sits nearest to contact and quote actions,
 * where someone is most likely to believe they are contacting a real
 * tradesperson.
 */
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/quote', label: 'Request a quote' },
];
---
<footer class="border-t border-border bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold tracking-tight">
        North East Joinery
      </p>
      <p class="mt-3 max-w-[40ch] text-sm leading-relaxed text-text-secondary">
        A demonstration website. North East Joinery is a fictional business and
        nothing submitted through this site reaches a real tradesperson.
      </p>
    </div>

    <nav aria-label="Footer">
      <p class="font-display text-sm font-semibold">Pages</p>
      <ul class="mt-3 space-y-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-text-secondary hover:text-ebonised hover:underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="font-display text-sm font-semibold">Service area</p>
      <p class="mt-3 text-sm leading-relaxed text-text-secondary">
        Hartlepool, Teesside and the wider North East of England. Fully
        insured, with free on-site consultations.
      </p>
    </div>
  </div>

  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-6 py-4 text-sm text-text-secondary">
      Demo project by
      <a
        href="https://teessidedigital.uk"
        class="underline hover:text-ebonised">Teesside Digital</a
      >. All imagery is illustrative; no real customers, projects or reviews
      are shown.
    </p>
  </div>
</footer>
