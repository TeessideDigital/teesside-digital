---
/**
 * Site header. Functional skeleton per PROJECT_BRIEF.md Section 8.
 *
 * The mobile menu is a native <details> disclosure: it needs no JavaScript,
 * is keyboard-operable for free, and keeps the header dependency-light. Known
 * trade-off: it does not close on outside click. If that grates once real
 * testing happens, it becomes a small React island -- not before.
 */
import Button from './Button.astro';

const nav = [
  { href: '/services', label: 'Services' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="border-b border-border bg-linen">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="font-display text-lg font-semibold tracking-tight">
      North East Joinery
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="font-display text-sm font-medium hover:underline hover:decoration-brass hover:decoration-2 hover:underline-offset-4"
          >
            {item.label}
          </a>
        ))
      }
      <Button href="/quote" label="Request a quote" />
    </nav>

    <details class="relative md:hidden">
      <summary
        class="cursor-pointer list-none border border-border px-3 py-1.5 font-display text-sm font-medium [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 top-full z-20 mt-2 w-52 border border-border bg-linen p-2"
        aria-label="Main"
      >
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block px-3 py-2 font-display text-sm font-medium hover:bg-surface"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="mt-2 border-t border-border pt-2">
            <a
              href="/quote"
              class="block px-3 py-2 font-display text-sm font-semibold underline decoration-brass decoration-2 underline-offset-4 hover:bg-surface"
            >
              Request a quote
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
