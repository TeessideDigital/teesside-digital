{
  "name": "teesside-digital",
  "version": "1.0.0",
  "description": "Teesside Digital — Precision engineering for small businesses. Website built with Astro 5, React, and Tailwind CSS.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-path .gitignore --plugin prettier-plugin-astro",
    "check": "astro check",
    "check:csp": "node tools/csp-hashes.mjs",
    "type-check": "astro sync && tsc --noEmit",
    "lint": "node -e \"console.log('Compatibility alias: Astro diagnostics, not ESLint. Run npm run check directly.')\" && npm run check"
  },
  "dependencies": {
    "astro": "7.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "^3.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "prettier": "^3.1.1",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
