{
  "name": "teesside-digital",
  "version": "1.0.0",
  "description": "The Teesside Digital website. Static, built with Astro and Tailwind CSS.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-path .gitignore --plugin prettier-plugin-astro",
    "check": "astro check",
    "check:csp": "node tools/csp-hashes.mjs",
    "type-check": "astro sync && tsc --noEmit",
    "lint": "node -e \"console.log('Compatibility alias: Astro diagnostics, not ESLint. Run npm run check directly.')\" && npm run check",
    "test:e2e": "playwright test",
    "check:links": "node tools/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.10.0",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "prettier": "^3.1.1",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
