---
import { SITE } from "@config/constants";
import Band from "../system/Band.astro";
import ClosingPanel from "../system/ClosingPanel.astro";
import FactsBand from "../system/FactsBand.astro";
import NumberedItem from "../system/NumberedItem.astro";
import PageOpening from "../system/PageOpening.astro";
import SectionLabel from "../system/SectionLabel.astro";

// Both photographs appear only once real ones are configured. There is no
// placeholder for either.
const portrait = SITE.portrait;
const localPhoto = SITE.localPhoto;
const facts = [
  {
    term: "Based in",
    detail: "Hartlepool, working across Teesside and the North East",
  },
  { term: "You deal with", detail: "Dave, from first message to finished work" },
  { term: "Studying", detail: "Computer Science with AI, The Open University" },
];
const carriesOver = [
  "Understanding what someone is actually trying to achieve.",
  "Precision and accountability matter when the result is permanent.",
  "Running a client-facing business meant direct communication and real responsibility.",
];
const principles = [
  {
    title: "Design judgement",
    text: "Years of client-facing visual work shape how problems are interpreted, discussed and turned into something clear.",
  },
  {
    title: "Technical discipline",
    text: "Computer Science study brings a stronger technical foundation to architecture, implementation and engineering decisions.",
  },
  {
    title: "Direct accountability",
    text: "The person discussing the project is also responsible for the design and technical decisions behind it.",
  },
  {
    title: "Practicality",
    text: "The result should suit the business and the people using it, rather than demonstrate how much technology can be added.",
  },
];
---

<div class="about-experience">
  <PageOpening
    label="About"
    title="About"
    lead="Teesside Digital is a solo technical consultancy built around direct access to the person designing and building the work."
  />
  <div class="opening-extra">
    <div class="td-wrap">
      {
        (portrait || localPhoto.src) && (
          <div
            class="photos"
            class:list={{
              "photos--both": Boolean(portrait && localPhoto.src),
            }}
          >
            {portrait && (
              <div class="photo photo--portrait">
                <img
                  src={portrait}
                  alt="Dave, who runs Teesside Digital"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            {localPhoto.src && (
              <div class="photo photo--local">
                <img
                  src={localPhoto.src}
                  alt={localPhoto.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>
        )
      }
      <FactsBand facts={facts} variant="labelled" />
    </div>
  </div>

  <section class="td-section" aria-label="The story so far">
    <div class="td-wrap story" data-reveal>
      <div class="story-head">
        <SectionLabel>The story so far</SectionLabel>
        <p>Practical experience, craftsmanship and engineering.</p>
      </div>
      <ol class="timeline" role="list">
        <li class="period">
          <p class="td-label">2005-2007</p>
          <h2 class="td-h2-statement">
            Technology was part of the story before Teesside Digital existed.
          </h2>
          <div class="td-prose">
            <p>Dave worked with web development around 2005-2007.</p>
            <p>
              His career then moved away from software for a period, including
              construction, before eventually returning to technical work.
            </p>
          </div>
        </li>
        <li class="period">
          <p class="td-label">2010-2021</p>
          <h2 class="td-h2-statement">
            For around eleven years, the work was visual, client-facing and
            precise.
          </h2>
          <div class="td-prose">
            <p>
              Dave worked professionally as a tattoo artist and studio owner
              from roughly 2010 to 2021.
            </p>
            <p>
              The work meant listening carefully, understanding what someone was
              actually trying to achieve, making judgement calls and executing
              them precisely. It also meant being directly accountable for a
              finished result another person had to live with.
            </p>
            <p>
              Running a studio added the other side of that responsibility:
              dealing with clients directly, managing expectations and standing
              behind the work.
            </p>
            <ul role="list">
              {carriesOver.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </li>
        <li class="period period--current">
          <p class="td-label">2022-present</p>
          <h2 class="td-h2-statement">
            From 2022, Dave returned formally to technical work through Computer
            Science study.
          </h2>
          <div class="td-prose">
            <p>
              Current study spans Computer Science, software and web
              development, AI and security principles.
            </p>
            <p>
              That study adds a stronger technical foundation to the same way of
              working: understand the problem, make considered decisions and
              build something that remains understandable afterwards.
            </p>
            <ul role="list">
              <li>software / web development</li>
              <li>AI</li>
              <li>security principles</li>
            </ul>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <Band inverse>
    <section class="td-section band-section" aria-labelledby="carries-heading">
      <div class="td-wrap pairing" data-reveal>
        <div class="pairing-head">
          <SectionLabel>What carries over</SectionLabel>
          <h2 class="td-h2" id="carries-heading">
            The career path was not linear.<br />The working principles are.
          </h2>
        </div>
        <ul class="pairing-list" role="list">
          {
            principles.map((principle, index) => (
              <NumberedItem
                number={String(index + 1).padStart(2, "0")}
                title={principle.title}
                text={principle.text}
              />
            ))
          }
        </ul>
      </div>
    </section>
  </Band>

  <section class="td-section band-section" aria-labelledby="relationship-heading">
    <div class="td-wrap" data-reveal>
      <div class="td-split">
        <h2 class="td-h2-statement" id="relationship-heading">
          You work directly with Dave.
        </h2>
        <div class="td-prose">
          <p>
            There is no account-manager layer between the conversation and the
            work.
          </p>
          <p>
            Context stays with the person designing and building the project,
            which means fewer handoffs and clearer accountability.
          </p>
          <p>
            Design and technical decisions stay connected from the first
            conversation through implementation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="closing">
    <div class="td-wrap" data-reveal>
      <ClosingPanel
        title="Tell Dave what your business needs."
        text="You do not need a technical brief."
      />
    </div>
  </div>
</div>

<style>
  .about-experience {
    color: var(--text);
  }
  .opening-extra {
    padding-block-end: 56px;
  }
  /* Real photographs only. Each slot exists only when its setting is filled. */
  .photos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--td-gap);
    margin-block-end: var(--td-gap);
  }
  .photo {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
  }
  .photo img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .photo--portrait {
    aspect-ratio: 4 / 5;
    max-inline-size: 384px;
  }
  .photo--local {
    aspect-ratio: 3 / 2;
  }

  /* The story so far: a label on the left, a timeline on the right. */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px var(--td-gap);
  }
  .story-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-content: start;
  }
  .story-head p:not(.td-label) {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-2);
  }
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-inline-start: 1px solid var(--border-strong);
    min-inline-size: 0;
  }
  .period {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    padding: 0 0 48px 28px;
  }
  .period:last-child {
    padding-block-end: 0;
  }
  /* The dot on the rule. The current period's is filled with the accent. */
  .period::before {
    content: "";
    position: absolute;
    inset-inline-start: -6px;
    inset-block-start: 4px;
    box-sizing: border-box;
    inline-size: 11px;
    block-size: 11px;
    border: 1px solid var(--steel);
    border-radius: 50%;
    background: var(--bg);
  }
  .period--current::before {
    border-color: var(--accent-text);
    background: var(--accent-text);
  }
  .period--current > .td-label {
    color: var(--accent-text);
  }

  /* What carries over. */
  .band-section {
    border-block-start: 0;
  }
  .pairing-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-content: start;
    min-inline-size: 0;
  }
  .pairing-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 26px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    min-inline-size: 0;
  }
  .pairing {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px var(--td-gap);
  }
  .closing {
    padding-block-end: var(--td-section);
  }
  @media (min-width: 48rem) {
    .opening-extra {
      padding-block-end: 72px;
    }
    .photos--both {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .photos--both .photo--portrait {
      grid-column: 1 / span 4;
      max-inline-size: none;
    }
    /* Beside the portrait, the local photograph takes the portrait's height. */
    .photos--both .photo--local {
      position: relative;
      grid-column: 5 / span 8;
      aspect-ratio: auto;
    }
    .photos--both .photo--local img {
      position: absolute;
      inset: 0;
    }
    .period {
      padding: 0 0 72px 48px;
    }
    .pairing-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }
  @media (min-width: 64rem) {
    .opening-extra {
      padding-block-end: 96px;
    }
    .story,
    .pairing {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .story-head {
      grid-column: 1 / span 4;
    }
    .timeline {
      grid-column: 5 / span 8;
    }
    .pairing-head {
      grid-column: 1 / span 5;
    }
    .pairing-list {
      grid-column: 7 / span 6;
    }
  }
  @media (forced-colors: active) {
    .photo,
    .timeline {
      border-color: CanvasText;
    }
    .period::before {
      border-color: CanvasText;
      background: Canvas;
    }
    .period--current::before {
      background: CanvasText;
    }
  }
</style>
