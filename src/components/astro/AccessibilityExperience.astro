---
import { SITE } from "@config/constants";
import PageOpening from "../system/PageOpening.astro";
---

<div class="accessibility-experience">
  <PageOpening
    label="Accessibility"
    title="Accessibility"
    lead="Teesside Digital wants this website to be usable by as many people as possible, including people who use a keyboard, screen magnification, high-contrast settings or assistive technology."
  >
    <p>Last reviewed: 13 October 2026</p>
  </PageOpening>
  <div class="td-section">
    <div class="td-wrap">
      <section class="td-split" aria-labelledby="standard-heading">
        <h2 class="td-h2-statement" id="standard-heading">The standard</h2>
        <div class="td-prose">
          <p>
            The target is WCAG 2.2 level AA, the widely used international
            standard for web accessibility.
          </p>
          <p>
            It is a target, not a certificate. The website has not been
            independently audited.
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="checked-heading">
        <h2 class="td-h2-statement" id="checked-heading">What has been checked</h2>
        <div class="td-prose">
          <p>These checks were carried out in Microsoft Edge on Windows:</p>
          <ul role="list">
            <li>
              using every page and both forms with a keyboard only, with a
              visible focus indicator throughout
            </li>
            <li>text enlarged to twice its normal size</li>
            <li>narrow screens down to 320 pixels wide</li>
            <li>high-contrast (forced colours) mode</li>
            <li>reduced-motion settings, which turn off the page animations</li>
            <li>with JavaScript turned off, including submitting both forms</li>
            <li>
              colour contrast of text, links and form controls in both the Dark
              and Light themes
            </li>
          </ul>
          <!-- UPDATE-AFTER-TEST: screen reader -->
        </div>
      </section>
      <section class="td-split" aria-labelledby="unchecked-heading">
        <h2 class="td-h2-statement" id="unchecked-heading">Not yet checked</h2>
        <div class="td-prose">
          <ul role="list">
            <li>other browsers, including Safari and Firefox</li>
            <li>real phones and tablets</li>
            <li>screen readers</li>
            <li>a full independent audit</li>
          </ul>
          <p>
            These will be checked as the website develops, and this page will be
            updated.
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="issues-heading">
        <h2 class="td-h2-statement" id="issues-heading">Known issues</h2>
        <div class="td-prose">
          <p>No known issues at the moment.</p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="features-heading">
        <h2 class="td-h2-statement" id="features-heading">Features that help</h2>
        <div class="td-prose">
          <ul role="list">
            <li>a "Skip to main content" link at the start of every page</li>
            <li>a choice of Dark or Light theme, remembered on your device</li>
            <li>
              animations are switched off if your device is set to reduce motion
            </li>
            <li>the website works without JavaScript, including both forms</li>
          </ul>
        </div>
      </section>
      <section class="td-split" aria-labelledby="report-heading">
        <h2 class="td-h2-statement" id="report-heading">Report a problem</h2>
        <div class="td-prose">
          <p>
            If something on this website is difficult to use, or you need
            information from it in a different format, email
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
          </p>
          <p>
            It helps to say which page you were on and what happened. Dave will
            reply by email and, where he can, provide the information another
            way.
          </p>
        </div>
      </section>
    </div>
  </div>
</div>
