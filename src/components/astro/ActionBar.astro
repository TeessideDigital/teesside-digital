---
// Phone-width bar fixed to the bottom of the screen. BaseLayout leaves it out
// on Contact and the website review, where the form is the action.
// "Call Dave" exists only when a phone number is configured.
import { SITE, telephoneHref } from "@config/constants";
import { projectEnquiry } from "@config/navigation";
---

<div class="action-bar" class:list={{ "has-call": Boolean(SITE.phone) }}>
  {
    SITE.phone && (
      <a
        class="td-button td-button--secondary"
        href={telephoneHref(SITE.phone)}
      >
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linejoin="round"
        >
          <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
        </svg>
        <span>Call Dave</span>
      </a>
    )
  }
  <a class="td-button td-button--primary" href={projectEnquiry.href}>
    <span>Get in touch</span>
  </a>
</div>
<style>
  .action-bar {
    display: none;
  }
  @media (max-width: 47.999rem) {
    .action-bar {
      position: fixed;
      z-index: 40;
      inset-inline: 0;
      inset-block-end: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
      border-block-start: 1px solid var(--border-strong);
      background: var(--bg-deep);
    }
    .has-call {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .action-bar a {
      min-block-size: 46px;
      padding-inline: 12px;
      font-size: 1rem;
    }
    .action-bar svg {
      color: var(--accent-text);
    }
    /* Out of the way of the open menu and of the on-screen keyboard. */
    :global(:root[data-menu-open]) .action-bar,
    :global(body:has(:is(input:not([type="radio"]), textarea, select):focus))
      .action-bar {
      display: none;
    }
  }
  @media (forced-colors: active) {
    .action-bar {
      border-color: CanvasText;
      background: Canvas;
    }
  }
  @media print {
    .action-bar {
      display: none;
    }
  }
</style>
