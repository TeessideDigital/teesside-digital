---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  // Supply an imported local image, not a public URL.
  image: ImageMetadata;
  alt?: string;
  position?: string;
}
const { image, alt = "", position = "center" } = Astro.props;
const widths = [
  ...new Set(
    [480, 768, 1024, 1440, 1920, 2560].map((width) =>
      Math.min(width, image.width),
    ),
  ),
];
// The image spans the opening canvas, excluding the desktop SiteIndex.
// Retain a 2560px candidate for high-density desktop delivery.
// Account for the uncropped width of the tall mobile field as well as DPR.
const sizes =
  "(min-width: 75rem) max(calc(100vw - 15rem), 1180px), (min-width: 58rem) max(100vw, 1180px), max(530px, 128vw)";
---

<div class="atmospheric-media" style={{ "--image-position": position }}>
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    widths={widths}
    sizes={sizes}
    width={Math.min(image.width, 1920)}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    pictureAttributes={{ class: "environment-picture" }}
  />
</div>

<style>
  .atmospheric-media {
    grid-column: 1 / -1;
    position: relative;
    min-inline-size: 0;
    height: clamp(22rem, 85cqi, 40rem);
    margin: -1rem -1.5rem -2rem;
    z-index: -1;
    pointer-events: none;
  }
  .atmospheric-media :global(picture) {
    display: block;
    position: absolute;
    inset: 0;
    clip-path: polygon(27% 0, 100% 0, 100% 100%, 0 100%, 0 35%);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 20%,
      #000 72%,
      transparent 100%
    );
  }
  .atmospheric-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--image-position);
  }
  @container opening (min-width: 40rem) {
    .atmospheric-media {
      margin-inline: -2.5rem;
    }
  }
  @container opening (min-width: 58rem) {
    .atmospheric-media {
      position: absolute;
      grid-column: auto;
      inset: 0 0 auto;
      height: 45rem;
      margin: 0;
    }
    .atmospheric-media :global(picture) {
      clip-path: none;
      mask-image:
        linear-gradient(to right, rgb(0 0 0 / 0.4), #000 75%),
        linear-gradient(
          to bottom,
          #000 45%,
          rgb(0 0 0 / 0.42) 60%,
          rgb(0 0 0 / 0.12) 85%,
          transparent 100%
        );
      mask-composite: intersect;
    }
    .atmospheric-media :global(img) {
      object-position: 50% 100%;
    }
    :global([data-theme="light"]) .atmospheric-media :global(picture) {
      mask-image:
        radial-gradient(
          ellipse 105% 100% at 0% 100%,
          transparent 60%,
          #000 100%
        ),
        linear-gradient(to bottom, #000 65%, transparent 100%);
    }
  }
  @media (forced-colors: active) {
    .atmospheric-media {
      visibility: hidden;
    }
  }
  @container opening (min-width: 58rem) and (max-width: 70rem) {
    :global([data-theme="light"]) .atmospheric-media :global(picture) {
      mask-image:
        radial-gradient(
          ellipse 105% 100% at 0% 100%,
          transparent 70%,
          #000 100%
        ),
        linear-gradient(to bottom, #000 65%, transparent 100%);
    }
  }
</style>
