---
import { isCurrentPage } from "@config/navigation";
---

<a
  class="brand-identity"
  href="/"
  aria-label="Teesside Digital home"
  aria-current={isCurrentPage(Astro.url.pathname, "/") ? "page" : undefined}
>
  <img
    src="/images/logo/teesside-digital-mark.svg"
    alt=""
    width="64"
    height="64"
  />
  <span class="brand-wording"><span>TEESSIDE</span><span>DIGITAL</span></span>
</a>
<style>
  /* Two stacked words beside a fixed-size mark, so enlarged text cannot push
     the name past a narrow screen. */
  .brand-identity,
  .brand-identity:hover {
    display: flex;
    align-items: center;
    gap: 12px;
    inline-size: fit-content;
    min-block-size: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .brand-identity:hover {
    color: var(--accent-text-hover);
  }
  img {
    inline-size: 36px;
    block-size: 36px;
    flex: none;
  }
  .brand-wording {
    display: grid;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }
  @media (min-width: 75rem) {
    .brand-identity {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    img {
      inline-size: 48px;
      block-size: 48px;
    }
    .brand-wording {
      font-size: 0.9375rem;
    }
  }
</style>
