---
/**
 * Button.astro
 *
 * Reusable button component.
 * Can render as:
 * - Link (if href is provided)
 * - Button (if onclick or form submission)
 *
 * Variants:
 * - primary (accent background, text primary)
 * - secondary (surface background, text accent)
 * - outline (transparent, border, text accent)
 *
 * Sizes:
 * - xs, sm, md (default), lg, xl
 *
 * Props:
 * - href?: string (renders <a> instead of <button>)
 * - variant?: 'primary' | 'secondary' | 'outline'
 * - size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl'
 * - disabled?: boolean
 * - class?: string (additional Tailwind classes)
 * - ... other HTML attributes
 */

import type { HTMLAttributes } from 'astro/types';

/**
 * HTMLAttributes<'button' | 'a'> does not cleanly union each tag's own
 * attribute set the way it might look like it should -- it drops
 * anchor-specific attributes (target, rel) entirely, and produces an
 * over-broad `type` that isn't assignable to a real <button>'s stricter
 * 'button' | 'submit' | 'reset' union. Rather than relying on that merged
 * type, the properties this component actually needs are declared
 * explicitly here, narrowing/adding to what's inherited.
 */
interface Props extends HTMLAttributes<'button' | 'a'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
}

const { href, variant = 'primary', size = 'md', disabled = false, class: customClass = '', ...attrs } = Astro.props as Props;

/**
 * Size mappings
 */
const sizeClasses = {
  xs: 'px-2 py-1 text-xs',
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-4 py-2 text-sm md:text-base',
  lg: 'px-6 py-3 text-base',
  xl: 'px-8 py-4 text-lg',
};

/**
 * Variant mappings
 */
const variantClasses = {
  primary: 'bg-accent text-background hover:bg-accent-hover disabled:bg-text-secondary disabled:cursor-not-allowed',
  secondary: 'bg-surface-raised text-accent-text hover:bg-surface border border-border disabled:border-text-secondary disabled:text-text-secondary disabled:cursor-not-allowed',
  outline:
    'border border-accent text-accent-text hover:bg-accent hover:text-background disabled:border-text-secondary disabled:text-text-secondary disabled:cursor-not-allowed',
};

/**
 * Base classes (always applied)
 */
const baseClasses =
  'inline-flex items-center justify-center gap-2 rounded font-medium transition-all duration-200 ease-out focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-background';

/**
 * Combine all classes
 */
const allClasses = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${customClass}`;

/**
 * Element type
 */
const Element = href ? 'a' : 'button';
---

<Element href={href} disabled={disabled} class={allClasses} {...attrs}>
  <slot />
</Element>

<style>
  a,
  button {
    cursor: pointer;
    user-select: none;
  }

  button:disabled,
  a[disabled] {
    opacity: 0.6;
  }

  /* Prevent text selection during click */
  a,
  button {
    -webkit-user-select: none;
    -moz-user-select: none;
    user-select: none;
  }
</style>
