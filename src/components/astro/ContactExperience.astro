---
import { SITE } from "@config/constants";
import { websiteReview } from "@config/navigation";
import ContactForm from "./ContactForm.astro";
import PageOpening from "../system/PageOpening.astro";
import ArrowLink from "../system/ArrowLink.astro";
---

<div class="contact-experience">
  <PageOpening
    label="Contact"
    title="Contact"
    lead="Tell Dave what your business needs and what is getting in the way. You do not need a technical brief."
  >
    <p>Enquiries go straight to Dave, who replies personally by email.</p>
    <p>
      <span>Prefer email?</span>
      <a class="td-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </PageOpening>
  {/* The form carries the "Your enquiry" name, so this wrapper is not a second landmark. */}
  <div class="td-section">
    <div class="td-wrap">
      <div class="td-split">
        <h2 class="td-h2-statement" id="enquiry-heading">Your enquiry</h2>
        <div><ContactForm /></div>
      </div>
    </div>
  </div>
  <section class="td-section alternative" aria-label="Website review">
    <div class="td-wrap">
      <p>Looking for a free website review instead?</p>
      <ArrowLink href={websiteReview.href}>Request a website review</ArrowLink>
    </div>
  </section>
</div>

<style>
  /* A quieter close than a full section. */
  .alternative {
    padding-block: 40px 56px;
  }
  .alternative p {
    margin: 0 0 4px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-2);
  }
  @media (min-width: 48rem) {
    .alternative {
      padding-block: 48px 72px;
    }
    .alternative p {
      font-size: 1.0625rem;
    }
  }
</style>
