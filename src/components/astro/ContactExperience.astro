---
import { SITE } from "@config/constants";
import { websiteReview } from "@config/navigation";
import ContactForm from "./ContactForm.astro";
---

<div class="contact-experience">
  <header class="orientation scene grid">
    <h1>Contact</h1>
    <p class="framing">
      Tell Dave what your business needs and what is getting in the way. You do
      not need a technical brief.
    </p>
    <p class="who">
      Enquiries go straight to Dave, who replies personally by email.
    </p>
    <p class="email">
      <span>Prefer email?</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </header>
  <section class="enquiry scene grid" aria-labelledby="enquiry-heading">
    <h2 id="enquiry-heading">Your enquiry</h2>
    <div class="enquiry-form"><ContactForm /></div>
  </section>
  <section class="review scene grid" aria-label="Website review">
    <div class="review-block short-rule">
      <p>Looking for a free website review instead?</p>
      <a class="review-link" href={websiteReview.href}>
        <span>Request a website review</span>
        <svg
          aria-hidden="true"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><path d="M3 12h18m-7-7 7 7-7 7"></path></svg
        >
      </a>
    </div>
  </section>
</div>

<style>
  /* Mirrors the About field: same container, grid, title scale and rules. */
  .contact-experience {
    container: contact / inline-size;
    max-inline-size: 100rem;
    margin-inline: auto;
    color: rgb(var(--color-text));
  }
  .scene {
    margin-inline: 1.5rem;
    padding-block: 3rem 3.5rem;
  }
  .scene + .scene {
    border-block-start: var(--rule-width) solid rgb(var(--color-rule));
  }
  h1,
  h2,
  p {
    margin: 0;
  }
  h1,
  h2 {
    font-family: var(--font-display);
    font-weight: 400;
    overflow-wrap: anywhere;
  }
  h1 {
    font-size: clamp(3rem, 12cqi, 3.625rem);
    letter-spacing: -0.055em;
    line-height: 1;
  }
  h2 {
    font-size: clamp(1.875rem, 8cqi, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  p {
    font-size: 1rem;
    line-height: 1.55;
    color: rgb(var(--color-text-muted));
    overflow-wrap: anywhere;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .grid > * {
    min-inline-size: 0;
  }
  .orientation {
    padding-block-start: 3.5rem;
  }
  .framing {
    margin-block-start: 2rem;
    font-size: 1.25rem;
    line-height: 1.4;
    max-inline-size: 35ch;
  }
  .who {
    margin-block-start: 3rem;
    border-block-start: var(--rule-width) solid rgb(var(--color-rule));
    padding-block-start: 1rem;
  }
  .email {
    margin-block-start: 1.5rem;
  }
  .email span {
    display: block;
  }
  a {
    color: rgb(var(--color-action));
    overflow-wrap: anywhere;
  }
  a:is(:hover, :focus-visible) {
    color: rgb(var(--color-action-hover));
  }
  .email a {
    display: inline-block;
    padding-block: 0.375rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .enquiry-form {
    margin-block-start: 2rem;
  }
  /* The alternative is a quieter close: a short rule, not a full section rule. */
  .scene + .scene.review {
    border-block-start: 0;
    padding-block: 0.5rem 4rem;
  }
  .short-rule::before {
    content: "";
    display: block;
    inline-size: 4rem;
    max-inline-size: 100%;
    border-block-start: var(--rule-width) solid rgb(var(--color-rule));
    margin-block-end: 0.875rem;
  }
  .review-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    inline-size: fit-content;
    max-inline-size: 100%;
    min-block-size: 2.75rem;
    margin-block-start: 0.5rem;
    border-block-end: var(--rule-width) solid rgb(var(--color-rule));
    color: rgb(var(--color-text-muted));
    text-decoration: none;
  }
  .review-link > span {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }
  svg {
    flex: none;
  }
  @container contact (min-width: 48rem) {
    .scene {
      margin-inline: 3rem;
      padding-block: 4rem 4.5rem;
    }
    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
    p {
      font-size: 1.125rem;
    }
    h1 {
      font-size: clamp(5.5rem, 9cqi, 6.5rem);
    }
    h2 {
      font-size: clamp(2.375rem, 4cqi, 3rem);
    }
    .orientation {
      padding-block: 4rem 3.5rem;
    }
    .orientation h1 {
      grid-column: 1 / 6;
      grid-row: 1;
    }
    .framing {
      grid-column: 7 / 12;
      grid-row: 1;
      margin-block-start: 4.5rem;
      font-size: 1.375rem;
    }
    .who {
      grid-column: 1 / 6;
      grid-row: 2;
      font-size: 1rem;
      margin-block-start: 3.5rem;
    }
    .email {
      grid-column: 7 / 12;
      grid-row: 2;
      font-size: 1rem;
      margin-block-start: 3.5rem;
      padding-block-start: calc(1rem + var(--rule-width));
    }
    .enquiry h2 {
      grid-column: 1 / 4;
      grid-row: 1;
    }
    .enquiry-form {
      grid-column: 5 / 12;
      grid-row: 1;
      margin-block-start: 0.5rem;
    }
    .review-block {
      grid-column: 1 / 7;
    }
    .scene + .scene.review {
      padding-block: 0.5rem 5rem;
    }
  }
  @media (forced-colors: active) {
    a {
      color: LinkText;
    }
    .scene + .scene,
    .who,
    .short-rule::before {
      border-color: CanvasText;
    }
    .review-link {
      border-color: LinkText;
    }
  }
</style>
