---
// Project enquiry form. Without JavaScript the browser validates and posts it
// natively; the shared engine only replaces that with accessible, truthful
// states. The copy the engine shows lives here, beside the fields it describes.
import { SITE } from "@config/constants";
import "../../styles/forms.css";
---

<form
  class="site-form contact-form"
  name="enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-sending="Sending your enquiry..."
  data-rejected={`Your enquiry was not sent. Please try again, or email Dave at ${SITE.email}.`}
  data-uncertain={`The website could not confirm whether your enquiry was received. To check, email Dave at ${SITE.email}. Sending again may create a duplicate.`}
>
  <input type="hidden" name="form-name" value="enquiry" />
  <div hidden>
    <label for="contact-bot-field">Leave this field empty</label>
    <input
      id="contact-bot-field"
      name="bot-field"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <div class="fields">
    <div
      class="status error-summary"
      data-state="error"
      role="group"
      aria-labelledby="contact-summary-heading"
      tabindex="-1"
      hidden
    >
      <h3 id="contact-summary-heading">Some details need attention</h3>
      <ul></ul>
    </div>
    <p class="form-note required-note">
      All fields are required unless marked optional.
    </p>
    <div class="pair">
      <div class="field">
        <label for="contact-name">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="100"
          required
          data-missing="Enter your name."
        />
        <p class="field-message" id="contact-name-error" hidden></p>
      </div>
      <div class="field">
        <label for="contact-email">Email address</label>
        <p class="hint" id="contact-email-hint">
          The address Dave should use to reply.
        </p>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby="contact-email-hint"
          data-missing="Enter an email address so Dave can reply."
          data-format="Enter an email address in the format name@example.com."
        />
        <p class="field-message" id="contact-email-error" hidden></p>
      </div>
    </div>
    <div class="pair">
      <div class="field">
        <label for="contact-business">Business name (optional)</label>
        <input
          id="contact-business"
          name="business"
          type="text"
          autocomplete="organization"
          maxlength="150"
        />
      </div>
      <div class="field">
        <label for="contact-website">Website address (optional)</label>
        <input
          id="contact-website"
          name="website"
          type="text"
          inputmode="url"
          autocomplete="url"
          maxlength="300"
          data-rule="website"
          data-format="Enter a website address like example.co.uk, or leave this blank."
        />
        <p class="field-message" id="contact-website-error" hidden></p>
      </div>
    </div>
    <div class="field measure">
      <label for="contact-message">What do you need help with?</label>
      <p class="hint" id="contact-message-hint">
        Describe what you want to do, what is getting in the way and anything
        that already works well. If there is a date the work needs to support,
        mention it here.
      </p>
      <textarea
        id="contact-message"
        name="message"
        rows="8"
        maxlength="5000"
        required
        aria-describedby="contact-message-hint"
        data-missing="Add a short description of what you need help with."
      ></textarea>
      <p class="field-message" id="contact-message-error" hidden></p>
    </div>
    <div class="field half">
      <label for="contact-budget">Budget or spending limit (optional)</label>
      <p class="hint" id="contact-budget-hint">
        A rough figure or limit helps Dave suggest a proportionate scope. Leave
        it blank if you are not sure.
      </p>
      <input
        id="contact-budget"
        name="budget"
        type="text"
        maxlength="100"
        aria-describedby="contact-budget-hint"
      />
    </div>
    <div class="privacy measure">
      <p>
        Dave will use these details to reply to your enquiry. Please do not
        include passwords, payment details or sensitive customer information.
      </p>
      <p><a href="/privacy/">Read the privacy notice</a></p>
    </div>
    <div>
      <button class="submit" type="submit">
        <span>Send your enquiry</span>
        <svg
          aria-hidden="true"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
        >
      </button>
      <div class="status status-region" role="status" aria-live="polite"></div>
    </div>
  </div>
  <div class="status confirmation" data-state="success" hidden>
    <h3 tabindex="-1">Enquiry received</h3>
    <p>
      Your enquiry has been received. Dave will review the details and reply by
      email.
    </p>
    <p>
      If you need to add anything, email <a href={`mailto:${SITE.email}`}
        >{SITE.email}</a
      >.
    </p>
  </div>
</form>

<script>
  import { initForm } from "../../scripts/form-submission";
  initForm(document.querySelector("form.contact-form"));
</script>
