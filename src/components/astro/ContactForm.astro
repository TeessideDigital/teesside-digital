---
// Project enquiry form. Without JavaScript the browser validates and posts it
// natively; the script only replaces that with accessible, truthful states.
import { SITE } from "@config/constants";
---

<form
  class="contact-form"
  name="enquiry"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <input type="hidden" name="form-name" value="enquiry" />
  <div hidden>
    <label for="contact-bot-field">Leave this field empty</label>
    <input
      id="contact-bot-field"
      name="bot-field"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <div class="fields">
    <div
      class="status error-summary"
      data-state="error"
      role="group"
      aria-labelledby="contact-summary-heading"
      tabindex="-1"
      hidden
    >
      <h3 id="contact-summary-heading">Some details need attention</h3>
      <ul></ul>
    </div>
    <p class="required-note">
      All fields are required unless marked optional.
    </p>
    <div class="pair">
      <div class="field">
        <label for="contact-name">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="100"
          required
        />
        <p class="field-message" id="contact-name-error" hidden></p>
      </div>
      <div class="field">
        <label for="contact-email">Email address</label>
        <p class="hint" id="contact-email-hint">
          The address Dave should use to reply.
        </p>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby="contact-email-hint"
        />
        <p class="field-message" id="contact-email-error" hidden></p>
      </div>
    </div>
    <div class="pair">
      <div class="field">
        <label for="contact-business">Business name (optional)</label>
        <input
          id="contact-business"
          name="business"
          type="text"
          autocomplete="organization"
          maxlength="150"
        />
      </div>
      <div class="field">
        <label for="contact-website">Website address (optional)</label>
        <input
          id="contact-website"
          name="website"
          type="text"
          inputmode="url"
          autocomplete="url"
          maxlength="300"
        />
        <p class="field-message" id="contact-website-error" hidden></p>
      </div>
    </div>
    <div class="field measure">
      <label for="contact-message">What do you need help with?</label>
      <p class="hint" id="contact-message-hint">
        Describe what you want to do, what is getting in the way and anything
        that already works well. If there is a date the work needs to support,
        mention it here.
      </p>
      <textarea
        id="contact-message"
        name="message"
        rows="8"
        maxlength="5000"
        required
        aria-describedby="contact-message-hint"></textarea>
      <p class="field-message" id="contact-message-error" hidden></p>
    </div>
    <div class="field half">
      <label for="contact-budget">Budget or spending limit (optional)</label>
      <p class="hint" id="contact-budget-hint">
        A rough figure or limit helps Dave suggest a proportionate scope. Leave
        it blank if you are not sure.
      </p>
      <input
        id="contact-budget"
        name="budget"
        type="text"
        maxlength="100"
        aria-describedby="contact-budget-hint"
      />
    </div>
    <div class="privacy measure">
      <p>
        Dave will use these details to reply to your enquiry. Please do not
        include passwords, payment details or sensitive customer information.
      </p>
      <p><a href="/privacy/">Read the privacy notice</a></p>
    </div>
    <div>
      <button class="submit" type="submit">
        <span>Send your enquiry</span>
        <svg
          aria-hidden="true"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
        >
      </button>
      <div class="status status-region" role="status" aria-live="polite"></div>
    </div>
  </div>
  <div class="status confirmation" data-state="success" hidden>
    <h3 tabindex="-1">Enquiry received</h3>
    <p>
      Your enquiry has been received. Dave will review the details and reply by
      email.
    </p>
    <p>
      If you need to add anything, email <a href={`mailto:${SITE.email}`}
        >{SITE.email}</a
      >.
    </p>
  </div>
</form>

<script>
  import "../../scripts/contact-form";
</script>

<style>
  /* The form measures itself, so paired rows depend on its own width. */
  .contact-form {
    container-type: inline-size;
    min-inline-size: 0;
    color: rgb(var(--color-text));
  }
  .fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }
  p,
  label {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .required-note,
  .hint,
  .privacy p {
    color: rgb(var(--color-text-muted));
  }
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem 1.5rem;
  }
  .field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    min-inline-size: 0;
  }
  label {
    display: block;
    color: rgb(var(--color-text));
    margin-block-end: 0.375rem;
  }
  .hint {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-block-end: 0.5rem;
  }
  /* Full boxes with square corners; the global control rule supplies a radius. */
  .fields :is(input, textarea) {
    display: block;
    inline-size: 100%;
    min-block-size: 3rem;
    margin: 0;
    padding: 0.6875rem 0.875rem;
    border: var(--rule-width) solid rgb(var(--color-control-border));
    border-radius: 0;
    background: rgb(var(--color-control));
    color: rgb(var(--color-text));
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
  }
  .fields textarea {
    resize: vertical;
    min-block-size: 12rem;
  }
  /* Error styling follows an explicit state only, never :invalid on load. */
  .fields :is(input, textarea)[aria-invalid="true"] {
    border-color: rgb(var(--color-error));
  }
  .field-message {
    margin-block-start: 0.5rem;
    color: rgb(var(--color-text));
    padding-inline-start: 0.75rem;
    border-inline-start: 2px solid rgb(var(--color-error));
  }
  .measure {
    max-inline-size: 65ch;
  }
  .privacy p + p {
    margin-block-start: 0.5rem;
  }
  /* The script creates some links and paragraphs, which carry no scope mark. */
  .contact-form :global(a) {
    color: rgb(var(--color-action));
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .contact-form :global(a:is(:hover, :focus-visible)) {
    color: rgb(var(--color-action-hover));
  }
  /* The shell's bordered enquiry control, as a real submit button. */
  .submit {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-inline-size: 100%;
    min-block-size: 3rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid rgb(var(--color-action));
    border-radius: 0;
    background: rgb(var(--color-surface-subtle));
    color: rgb(var(--color-action));
    font: inherit;
    line-height: 1.3;
    text-align: start;
    cursor: pointer;
  }
  .submit:hover {
    color: rgb(var(--color-action-hover));
  }
  /* The site-wide outline is the focus indicator; drop the V1 button ring. */
  .submit:focus {
    box-shadow: none;
  }
  .submit svg {
    flex: none;
  }
  /* Sending keeps the button focusable, so it is quietened, not disabled. */
  .submit[aria-disabled="true"] {
    border-color: rgb(var(--color-control-border));
    color: rgb(var(--color-text-muted));
    cursor: default;
  }

  /* One treatment for the summary, the live status and the confirmation. */
  .status {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid rgb(var(--color-rule));
    color: rgb(var(--color-text));
  }
  .status[data-state="error"] {
    border-color: rgb(var(--color-error));
  }
  .status[data-state="success"] {
    border-color: rgb(var(--color-success));
  }
  .status[data-state="warning"] {
    border-color: rgb(var(--color-warning));
  }
  .status :is(h2, h3) {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .status :global(p) {
    margin: 0;
    color: rgb(var(--color-text));
    font-size: 1rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .status :global(p + p) {
    margin-block-start: 0.5rem;
  }
  .status ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .status :global(li) {
    font-size: 1rem;
    line-height: 1.55;
  }
  .status :global(li + li) {
    margin-block-start: 0.25rem;
  }
  /* The live region exists from load; it takes up space only once it speaks. */
  .status-region:not(:empty) {
    margin-block-start: 1.25rem;
    max-inline-size: 65ch;
  }
  .contact-form [hidden] {
    display: none;
  }

  @container (min-width: 34rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: end;
    }
    .half input {
      max-inline-size: calc(50% - 0.75rem);
    }
    /* Shared rows keep labels and inputs level when only one field has a hint. */
    @supports (grid-template-rows: subgrid) {
      .pair {
        grid-template-rows: auto auto auto auto;
        row-gap: 0;
        align-items: start;
      }
      .pair .field {
        grid-row: span 4;
        grid-template-rows: subgrid;
      }
      .pair .hint {
        grid-row: 2;
      }
      .pair :is(input, textarea) {
        grid-row: 3;
      }
      .pair .field-message {
        grid-row: 4;
      }
    }
  }
  @container (min-width: 38rem) {
    p,
    label,
    .fields :is(input, textarea),
    .status :global(:is(p, li)) {
      font-size: 1.125rem;
    }
    .hint {
      font-size: 1rem;
    }
  }
  @media (forced-colors: active) {
    .contact-form :global(a) {
      color: LinkText;
    }
    .fields :is(input, textarea)[aria-invalid="true"] {
      border-width: 2px;
    }
    .status,
    .field-message {
      border-color: CanvasText;
    }
  }
</style>
