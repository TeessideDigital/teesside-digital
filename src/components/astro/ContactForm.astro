---
// Static project enquiry form. Submission handling arrives in a later phase;
// until then the browser's own validation and a native POST are the behaviour.
---

<form class="contact-form" name="contact" method="POST" data-netlify="true">
  <div class="fields">
    <p class="required-note">
      All fields are required unless marked optional.
    </p>
    <div class="pair">
      <div class="field">
        <label for="contact-name">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="100"
          required
        />
      </div>
      <div class="field">
        <label for="contact-email">Email address</label>
        <p class="hint" id="contact-email-hint">
          The address Dave should use to reply.
        </p>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby="contact-email-hint"
        />
      </div>
    </div>
    <div class="pair">
      <div class="field">
        <label for="contact-business">Business name (optional)</label>
        <input
          id="contact-business"
          name="business"
          type="text"
          autocomplete="organization"
          maxlength="150"
        />
      </div>
      <div class="field">
        <label for="contact-website">Website address (optional)</label>
        <input
          id="contact-website"
          name="website"
          type="text"
          inputmode="url"
          autocomplete="url"
          maxlength="300"
        />
      </div>
    </div>
    <div class="field measure">
      <label for="contact-message">What do you need help with?</label>
      <p class="hint" id="contact-message-hint">
        Describe what you want to do, what is getting in the way and anything
        that already works well. If there is a date the work needs to support,
        mention it here.
      </p>
      <textarea
        id="contact-message"
        name="message"
        rows="8"
        maxlength="5000"
        required
        aria-describedby="contact-message-hint"></textarea>
    </div>
    <div class="field half">
      <label for="contact-budget">Budget or spending limit (optional)</label>
      <p class="hint" id="contact-budget-hint">
        A rough figure or limit helps Dave suggest a proportionate scope. Leave
        it blank if you are not sure.
      </p>
      <input
        id="contact-budget"
        name="budget"
        type="text"
        maxlength="100"
        aria-describedby="contact-budget-hint"
      />
    </div>
    <div class="privacy measure">
      <p>
        Dave will use these details to reply to your enquiry. Please do not
        include passwords, payment details or sensitive customer information.
      </p>
      <p><a href="/privacy/">Read the privacy notice</a></p>
    </div>
    <div>
      <button class="submit" type="submit">
        <span>Send your enquiry</span>
        <svg
          aria-hidden="true"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
        >
      </button>
    </div>
  </div>
</form>

<style>
  /* The form measures itself, so paired rows depend on its own width. */
  .contact-form {
    container-type: inline-size;
    min-inline-size: 0;
    color: rgb(var(--color-text));
  }
  .fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }
  p,
  label {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .required-note,
  .hint,
  .privacy p {
    color: rgb(var(--color-text-muted));
  }
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem 1.5rem;
  }
  .field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    min-inline-size: 0;
  }
  label {
    display: block;
    color: rgb(var(--color-text));
    margin-block-end: 0.375rem;
  }
  .hint {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-block-end: 0.5rem;
  }
  /* Full boxes with square corners; the global control rule supplies a radius. */
  .fields :is(input, textarea) {
    display: block;
    inline-size: 100%;
    min-block-size: 3rem;
    margin: 0;
    padding: 0.6875rem 0.875rem;
    border: var(--rule-width) solid rgb(var(--color-control-border));
    border-radius: 0;
    background: rgb(var(--color-control));
    color: rgb(var(--color-text));
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
  }
  .fields textarea {
    resize: vertical;
    min-block-size: 12rem;
  }
  /* Error styling follows an explicit state only, never :invalid on load. */
  .fields :is(input, textarea)[aria-invalid="true"] {
    border-color: rgb(var(--color-error));
  }
  .field-message {
    margin-block-start: 0.5rem;
    color: rgb(var(--color-text));
    padding-inline-start: 0.75rem;
    border-inline-start: 2px solid rgb(var(--color-error));
  }
  .measure {
    max-inline-size: 65ch;
  }
  .privacy p + p {
    margin-block-start: 0.5rem;
  }
  a {
    color: rgb(var(--color-action));
    text-decoration: underline;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  a:is(:hover, :focus-visible) {
    color: rgb(var(--color-action-hover));
  }
  /* The shell's bordered enquiry control, as a real submit button. */
  .submit {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-inline-size: 100%;
    min-block-size: 3rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid rgb(var(--color-action));
    border-radius: 0;
    background: rgb(var(--color-surface-subtle));
    color: rgb(var(--color-action));
    font: inherit;
    line-height: 1.3;
    text-align: start;
    cursor: pointer;
  }
  .submit:hover {
    color: rgb(var(--color-action-hover));
  }
  /* The site-wide outline is the focus indicator; drop the V1 button ring. */
  .submit:focus {
    box-shadow: none;
  }
  .submit svg {
    flex: none;
  }

  /* Status styles for the submission phase. No status markup ships yet. */
  .status {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid rgb(var(--color-rule));
    color: rgb(var(--color-text));
  }
  .status[data-state="error"] {
    border-color: rgb(var(--color-error));
  }
  .status[data-state="success"] {
    border-color: rgb(var(--color-success));
  }
  .status[data-state="warning"] {
    border-color: rgb(var(--color-warning));
  }
  .status :is(h2, h3) {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .status p {
    color: rgb(var(--color-text));
  }
  .status p + p {
    margin-block-start: 0.5rem;
  }
  .status ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .status li + li {
    margin-block-start: 0.25rem;
  }

  @container (min-width: 34rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: end;
    }
    .half input {
      max-inline-size: calc(50% - 0.75rem);
    }
    /* Shared rows keep labels and inputs level when only one field has a hint. */
    @supports (grid-template-rows: subgrid) {
      .pair {
        grid-template-rows: auto auto auto auto;
        row-gap: 0;
        align-items: start;
      }
      .pair .field {
        grid-row: span 4;
        grid-template-rows: subgrid;
      }
      .pair .hint {
        grid-row: 2;
      }
      .pair :is(input, textarea) {
        grid-row: 3;
      }
      .pair .field-message {
        grid-row: 4;
      }
    }
  }
  @container (min-width: 38rem) {
    p,
    label,
    .fields :is(input, textarea) {
      font-size: 1.125rem;
    }
    .hint {
      font-size: 1rem;
    }
  }
  @media (forced-colors: active) {
    a {
      color: LinkText;
    }
    .fields :is(input, textarea)[aria-invalid="true"] {
      border-width: 2px;
    }
    .status,
    .field-message {
      border-color: CanvasText;
    }
  }
</style>
