---
/**
 * Footer.astro
 *
 * Site footer with:
 * - Branding/logo
 * - Navigation links
 * - Contact information
 * - Social media links
 * - Legal links (privacy, accessibility, terms)
 * - Copyright notice
 *
 * Sticky to bottom via flexbox in BaseLayout.
 */

import { SITE, NAVIGATION } from '@config/constants';
import Navigation from './Navigation.astro';
---

<footer class="bg-surface border-t border-border mt-auto">
  <div class="container-content py-12 md:py-16">
    {/* ============================================================
        Main Footer Content (Grid)
        ============================================================ */}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12 mb-8">
      {/* Column 1: Branding */}
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 group mb-4">
          <div class="flex flex-col gap-0 leading-none">
            <span class="text-base md:text-lg font-bold text-text-primary group-hover:text-accent transition-colors">
              {SITE.title}
            </span>
            <span class="text-xs text-text-secondary group-hover:text-accent transition-colors">
              {SITE.tagline}
            </span>
          </div>
        </a>
        <p class="text-sm text-text-secondary mb-6">
          Precision engineering for small businesses. Direct access to the developer.
        </p>

        {/* Social Links */}
        <div class="flex gap-4">
          <a
            href={`https://github.com/TeessideDigital`}
            aria-label="GitHub"
            class="text-text-secondary hover:text-accent transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
          </a>

          <a
            href={`https://linkedin.com/company/teessidedigital`}
            aria-label="LinkedIn"
            class="text-text-secondary hover:text-accent transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.474-2.229-1.66-2.229-1.004 0-1.601.681-1.863 1.34-.096.234-.12.561-.12.889v5.569h-3.554V9h3.554v1.561h.05c.496-.788 1.525-1.817 3.763-1.817 3.126 0 5.394 2.04 5.394 6.431v5.277zM5.337 7.433c-1.144 0-2.063-.925-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.14-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
            </svg>
          </a>

          <a
            href={`https://twitter.com/teessidedigital`}
            aria-label="Twitter"
            class="text-text-secondary hover:text-accent transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2s9 5 20 5a9.5 9.5 0 00-9-5.5c4.75 2.25 7-7 7-7z" />
            </svg>
          </a>
        </div>
      </div>

      {/* Column 2: Services */}
      <div class="md:col-span-1">
        <h3 class="text-sm font-semibold text-text-primary uppercase tracking-wide mb-4">Services</h3>
        <nav>
          <ul class="space-y-2">
            <li>
              <a href="/services/web-development" class="text-sm text-text-secondary hover:text-accent transition-colors">
                Web Development
              </a>
            </li>
            <li>
              <a href="/services/ai-automation" class="text-sm text-text-secondary hover:text-accent transition-colors">
                AI & Automation
              </a>
            </li>
            <li>
              <a href="/services/cybersecurity" class="text-sm text-text-secondary hover:text-accent transition-colors">
                Cybersecurity
              </a>
            </li>
          </ul>
        </nav>
      </div>

      {/* Column 3: Company */}
      <div class="md:col-span-1">
        <h3 class="text-sm font-semibold text-text-primary uppercase tracking-wide mb-4">Company</h3>
        <nav>
          <ul class="space-y-2">
            <li>
              <a href="/work" class="text-sm text-text-secondary hover:text-accent transition-colors">
                Work & Portfolio
              </a>
            </li>
            <li>
              <a href="/about" class="text-sm text-text-secondary hover:text-accent transition-colors">
                About Dave
              </a>
            </li>
            <li>
              <a href="/contact" class="text-sm text-text-secondary hover:text-accent transition-colors">
                Get in Touch
              </a>
            </li>
          </ul>
        </nav>
      </div>

      {/* Column 4: Contact */}
      <div class="md:col-span-1">
        <h3 class="text-sm font-semibold text-text-primary uppercase tracking-wide mb-4">Contact</h3>
        <ul class="space-y-2">
          <li>
            <a href={`mailto:${SITE.email}`} class="text-sm text-text-secondary hover:text-accent transition-colors">
              {SITE.email}
            </a>
          </li>
          <li class="text-sm text-text-secondary">
            Hartlepool<br />
            England, UK
          </li>
          <li>
            <a href="/contact" class="text-sm text-accent hover:text-accent-hover transition-colors font-medium">
              Contact form →
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* ============================================================
        Footer Bottom (Copyright + Legal)
        ============================================================ */}
    <div class="border-t border-border pt-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        {/* Copyright */}
        <p class="text-xs text-text-secondary">
          &copy; 2026 {SITE.title}. All rights reserved.
        </p>

        {/* Legal Links */}
        <nav class="flex gap-6">
          <a href="/privacy" class="text-xs text-text-secondary hover:text-accent transition-colors">
            Privacy Policy
          </a>
          <a href="/accessibility" class="text-xs text-text-secondary hover:text-accent transition-colors">
            Accessibility
          </a>
          <a href="/terms" class="text-xs text-text-secondary hover:text-accent transition-colors">
            Terms
          </a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
  }

  /**
   * Smooth transitions for link hovers
   */
  a {
    transition: color 0.2s ease-out;
  }

  /**
   * SVG icons scale on hover
   */
  a svg {
    transition: transform 0.2s ease-out;
  }

  a:hover svg {
    transform: scale(1.1);
  }

  /**
   * Responsive grid
   * Mobile: 1 column
   * Tablet/Desktop: 4 columns
   */
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
