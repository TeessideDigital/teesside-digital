---
import { SITE } from "@config/constants";
import { legalNavigation } from "@config/navigation";

interface Props {
  // Kept so existing pages need no change; every page now gets this footer.
  editorial?: boolean;
}
---

<footer class="site-footer">
  <div class="td-wrap footer-grid">
    <div class="footer-identity">
      <a class="footer-name" href="/">{SITE.title}</a>
      <p>Based in Hartlepool, working across Teesside and the North East.</p>
    </div>
    <div class="footer-meta">
      <nav aria-label="Footer navigation">
        <ul>
          {
            legalNavigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
      </nav>
      <small
        >Copyright {new Date().getFullYear()}
        {SITE.title}. All rights reserved.</small
      >
    </div>
  </div>
</footer>
<style>
  .site-footer {
    padding-block: 40px 48px;
    border-block-start: 1px solid var(--border);
    background: var(--bg-deep);
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px 24px;
  }
  .footer-identity,
  .footer-meta {
    display: grid;
    gap: 6px;
    align-content: start;
    min-inline-size: 0;
  }
  .footer-name,
  .footer-name:hover {
    inline-size: fit-content;
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  p {
    margin: 0;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--text-3);
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }
  a:hover {
    color: var(--accent-text-hover);
  }
  small {
    font-size: 0.875rem;
    color: var(--text-3);
  }
  @media (min-width: 48rem) {
    .site-footer {
      padding-block: 48px 64px;
    }
    .footer-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .footer-identity {
      grid-column: 1 / span 5;
    }
    .footer-meta {
      grid-column: 7 / span 6;
    }
  }
  /* Room for the fixed action bar, so it never sits over the last line. */
  @media (max-width: 47.999rem) {
    :global(body.has-action-bar) .site-footer {
      padding-block-end: calc(48px + 72px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (forced-colors: active) {
    .site-footer {
      border-color: CanvasText;
    }
  }
</style>
