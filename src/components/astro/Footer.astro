---
/**
 * Footer.astro
 *
 * Site footer with:
 * - Branding/logo, tagline, contact details, social links
 * - Capabilities column (real service pages only)
 * - Company column (work, about, contact)
 * - Legal column (privacy, accessibility, terms)
 * - Copyright notice
 *
 * Sticky to bottom via flexbox in BaseLayout.
 *
 * Note: no "TECHNOLOGY: ..." line here by design -- see PLAN.md's Phase 3.5
 * "Decisions resolved during planning" section. A footer tech-stack line
 * doesn't build trust with a non-technical audience and is a standing
 * maintenance liability every time the stack changes.
 */

import { SITE } from '@config/constants';
---

<footer class="bg-surface border-t border-border mt-auto">
  <div class="container-content py-12 md:py-16">
    {/* ============================================================
        Main Footer Content (Grid)
        ============================================================ */}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12 mb-8">
      {/* Column 1: Branding + contact details */}
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 group mb-4">
          <div class="flex flex-col gap-0 leading-none">
            <span class="text-base md:text-lg font-bold text-text-primary group-hover:text-accent-text transition-colors">
              {SITE.title}
            </span>
            <span class="text-xs text-text-secondary group-hover:text-accent-text transition-colors">
              {SITE.tagline}
            </span>
          </div>
        </a>
        <p class="text-sm text-text-secondary mb-4">
          Precision engineering for small businesses. Direct access to the developer.
        </p>

        {/* Contact details -- moved here from their own column so the three
            link columns can map cleanly onto Capabilities / Company / Legal */}
        <ul class="space-y-1 mb-6">
          <li>
            <a href={`mailto:${SITE.email}`} class="text-sm text-text-secondary hover:text-accent-text transition-colors">
              {SITE.email}
            </a>
          </li>
          <li class="text-sm text-text-secondary">
            Hartlepool, England, UK
          </li>
        </ul>

        {/* Social Links -- only accounts that actually exist and are live.
            LinkedIn and Twitter/X are not set up yet: add them back here
            once they exist rather than linking out to nothing. */}
        <div class="flex gap-4">
          <a
            href={`https://github.com/TeessideDigital`}
            aria-label="GitHub"
            class="text-text-secondary hover:text-accent-text transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
          </a>
        </div>
      </div>

      {/* Column 2: Capabilities (real service pages only -- do not add a
          4th item to match PLAN.md's illustrative brief example unless a
          4th service page actually exists) */}
      <div class="md:col-span-1">
        <h3 class="text-sm font-semibold text-text-primary uppercase tracking-wide mb-4">Capabilities</h3>
        <nav>
          <ul class="space-y-2">
            <li>
              <a href="/services/web-development" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                Web Development
              </a>
            </li>
            <li>
              <a href="/services/ai-automation" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                AI & Automation
              </a>
            </li>
            <li>
              <a href="/services/cybersecurity" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                Cybersecurity
              </a>
            </li>
          </ul>
        </nav>
      </div>

      {/* Column 3: Company */}
      <div class="md:col-span-1">
        <h3 class="text-sm font-semibold text-text-primary uppercase tracking-wide mb-4">Company</h3>
        <nav>
          <ul class="space-y-2">
            <li>
              <a href="/work" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                Work & Portfolio
              </a>
            </li>
            <li>
              <a href="/about" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                About Dave
              </a>
            </li>
            <li>
              <a href="/contact" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                Get in Touch
              </a>
            </li>
          </ul>
        </nav>
      </div>

      {/* Column 4: Legal -- promoted from the bottom copyright bar into its
          own column so all three link categories get equal visual weight */}
      <div class="md:col-span-1">
        <h3 class="text-sm font-semibold text-text-primary uppercase tracking-wide mb-4">Legal</h3>
        <nav>
          <ul class="space-y-2">
            <li>
              <a href="/privacy" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                Privacy Policy
              </a>
            </li>
            <li>
              <a href="/accessibility" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                Accessibility
              </a>
            </li>
            <li>
              <a href="/terms" class="text-sm text-text-secondary hover:text-accent-text transition-colors">
                Terms
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    {/* ============================================================
        Footer Bottom (Copyright only -- legal links now live in
        their own column above, not duplicated here)
        ============================================================ */}
    <div class="border-t border-border pt-8">
      <p class="text-xs text-text-secondary text-center md:text-left">
        &copy; {new Date().getFullYear()} {SITE.title}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
  }

  /**
   * Smooth transitions for link hovers
   */
  a {
    transition: color 0.2s ease-out;
  }

  /**
   * SVG icons scale on hover
   */
  a svg {
    transition: transform 0.2s ease-out;
  }

  a:hover svg {
    transform: scale(1.1);
  }

  /**
   * Responsive grid
   * Mobile: 1 column
   * Tablet/Desktop: 4 columns
   */
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
