---
import { SITE, BUSINESS } from "@config/constants";
import {
  primaryNavigation,
  projectEnquiry,
  websiteReview,
  legalNavigation,
} from "@config/navigation";
---

<footer class="site-footer">
  <div class="footer-identity">
    <a class="footer-name" href="/">{SITE.title}</a>
    <span>{BUSINESS.location}, UK</span>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </div>
  <nav aria-label="Footer navigation">
    <ul class="footer-links">
      {
        [...primaryNavigation, projectEnquiry, websiteReview].map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <ul class="footer-links footer-legal">
      {
        legalNavigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li><a href="https://github.com/TeessideDigital">GitHub</a></li>
    </ul>
  </nav>
  <small
    >Copyright {new Date().getFullYear()}
    {SITE.title}. All rights reserved.</small
  >
</footer>
<style>
  .site-footer {
    border-block-start: 1px solid rgb(var(--color-rule));
    background: rgb(var(--color-surface));
    padding: 2rem 1rem;
    display: grid;
    gap: 1.5rem;
    color: rgb(var(--color-text-muted));
    font-size: 0.875rem;
  }
  .footer-identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }
  .footer-name {
    color: rgb(var(--color-text));
    font-weight: 600;
    font-size: 1rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    overflow-wrap: anywhere;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .footer-legal a {
    color: rgb(var(--color-text-muted));
  }
  a:hover {
    color: rgb(var(--color-action-hover));
  }
  small {
    font-size: 0.75rem;
  }
  @media (min-width: 48rem) {
    .site-footer {
      padding: 2rem;
    }
  }
  @media (min-width: 75rem) {
    .site-footer {
      padding: 2rem 3rem;
    }
  }
</style>
