---
/**
 * src/components/astro/Header.astro
 *
 * Sticky header with navigation and mobile menu toggle.
 * Uses Teesside Digital logo (SVG) and responsive design.
 */

import Navigation from './Navigation.astro';
import MobileMenu from '../react/MobileMenu.tsx';
---

<header class="sticky top-0 z-40 w-full bg-surface border-b border-border">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-4 flex items-center justify-between">
    <!-- Logo & Home Link -->
    <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity" aria-label="Teesside Digital home">
      <img 
        src="/images/logos/teesside-digital-mark.svg" 
        alt="Teesside Digital" 
        class="h-8 w-auto"
      />
      <span class="hidden sm:inline-block text-lg font-semibold text-text-primary">
        Teesside Digital
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:block">
      <Navigation />
    </nav>

    <!-- Mobile Menu Toggle (React Island) -->
    <div class="md:hidden">
      <MobileMenu client:load />
    </div>
  </div>
</header>

<style>
  header {
    background: var(--surface);
  }
</style>
