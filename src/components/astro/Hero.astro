---
/**
 * Hero.astro
 *
 * Large hero section for homepage.
 * Displays:
 * - Large headline
 * - Subheading/description
 * - CTA button(s)
 * - Optional background image or gradient
 *
 * Props:
 * - title: string (main headline)
 * - highlightWord?: string (exact substring of title to render in accent
 *   colour, e.g. title="Precision Engineering for Small Businesses"
 *   highlightWord="Small Businesses". Must match the text in title exactly,
 *   including case -- if it isn't found, the headline just renders plain
 *   with no highlight and no error.)
 * - subtitle?: string (subheading, rendered as a small-caps badge)
 * - description?: string (longer description)
 * - ctaText?: string (button text)
 * - ctaHref?: string (button link)
 * - ctaSecondary?: { text: string, href: string } (secondary button)
 * - backgroundImage?: string (optional background image)
 * - backgroundGradient?: boolean (use gradient background)
 */

import Button from './Button.astro';

interface Props {
  title: string;
  highlightWord?: string;
  subtitle?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  ctaSecondary?: {
    text: string;
    href: string;
  };
  backgroundImage?: string;
  backgroundGradient?: boolean;
}

const {
  title,
  highlightWord,
  subtitle,
  description,
  ctaText = 'Get Started',
  ctaHref = '/contact',
  ctaSecondary,
  backgroundImage,
  backgroundGradient = false,
} = Astro.props as Props;

/**
 * Split the title around highlightWord so it can be wrapped in a coloured
 * span. This is a plain string match, not a template-driven Tailwind class
 * (that trap doesn't apply here), but it has its own quiet failure mode:
 * title.split() only returns exactly 2 parts if highlightWord occurs
 * exactly once. If it's missing, mistyped, or appears more than once, we
 * fall back to rendering the plain title untouched rather than guessing --
 * a silent no-op is safer than mangling the headline.
 */
const titleParts = highlightWord ? title.split(highlightWord) : [title];
const hasHighlight = Boolean(highlightWord) && titleParts.length === 2;
---

<section
  class={`
    relative min-h-screen md:min-h-[80vh] flex items-center justify-center
    py-16 md:py-20
    ${backgroundGradient ? 'bg-gradient-to-br from-background via-surface to-background' : 'bg-background'}
    overflow-hidden
  `}
>
  {/* Background Image (optional) */}
  {
    backgroundImage && (
      <div
        class="absolute inset-0 opacity-10"
        style={{
          backgroundImage: `url(${backgroundImage})`,
          backgroundSize: 'cover',
          backgroundPosition: 'center',
        }}
        aria-hidden="true"
      />
    )
  }

  {/* Decorative elements (optional, for premium feel) */}
  <div
    class="hero-dot-grid absolute inset-0"
    aria-hidden="true"
  />
  <div
    class="absolute top-20 right-10 w-64 h-64 bg-accent opacity-5 rounded-full blur-3xl"
    aria-hidden="true"
  />
  {/*
    NOTE: use opacity-[N] (arbitrary value syntax), not opacity-N, for any
    percentage that isn't one of Tailwind's default named steps (0, 5, 10,
    20, 25, 30, 40, 50, 60, 70, 75, 80, 90, 95, 100). An unrecognised class
    like "opacity-3" doesn't error at build time -- Tailwind just skips it
    silently -- so this element rendered at full 100% opacity instead of
    3%, turning a subtle background wash into a solid glowing circle that
    dominated the whole screen on mobile. Found via a live mobile
    screenshot; desktop-only review never surfaced it because the effect
    at 100% opacity still looked plausible as "a strong ambient glow" on a
    wide viewport with the headline text having far more room around it.
  */}
  <div
    class="absolute bottom-10 left-10 w-96 h-96 bg-accent opacity-[0.03] rounded-full blur-3xl"
    aria-hidden="true"
  />

  {/* Content */}
  <div class="container-content relative z-10 text-center max-w-4xl">
    {/* Subtitle/Badge (optional) */}
    {
      subtitle && (
        <div class="mb-6 md:mb-8 inline-block">
          <span class="inline-flex items-center gap-2 text-xs md:text-sm font-semibold uppercase tracking-widest text-accent-text bg-surface rounded-full px-4 py-2 border border-border">
            <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true" />
            {subtitle}
          </span>
        </div>
      )
    }

    {/* Main Headline */}
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-text-primary mb-6 md:mb-8 leading-tight">
      {
        hasHighlight ? (
          <>
            {titleParts[0]}<span class="text-accent">{highlightWord}</span>{titleParts[1]}
          </>
        ) : (
          title
        )
      }
    </h1>

    {/* Description */}
    {
      description && (
        <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto mb-8 md:mb-12 leading-relaxed">
          {description}
        </p>
      )
    }

    {/* CTA Buttons */}
    <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-6">
      <Button href={ctaHref} variant="primary" size="lg">
        {ctaText}
      </Button>

      {
        ctaSecondary && (
          <Button href={ctaSecondary.href} variant="outline" size="lg">
            {ctaSecondary.text}
          </Button>
        )
      }
    </div>
  </div>

  {/* Scroll Indicator (optional) */}
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce md:block hidden" aria-hidden="true">
    <svg class="w-6 h-6 text-text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  /* Prevent text selection on decorative elements */
  [aria-hidden='true'] {
    user-select: none;
    pointer-events: none;
  }

  /*
   * Static dot-grid background -- a "structured/technical" texture without
   * any animation, JS, or motion. Purely decorative (aria-hidden), so it
   * has no accessibility exception to account for and needs no
   * prefers-reduced-motion fallback, unlike an animated equivalent would.
   * Faded via a radial mask so it reads as a subtle texture rather than
   * ending in a hard rectangular edge.
   */
  .hero-dot-grid {
    background-image: radial-gradient(circle, rgba(91, 127, 158, 0.35) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
    opacity: 0.4;
  }

  /* Smooth gradient text (optional, uncomment if needed) */
  /*
  h1 {
    background: linear-gradient(135deg, #f0f0f0, #9a9a9a);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  */

  /* Responsive adjustments */
  @media (max-width: 768px) {
    section {
      min-height: auto;
      padding: 4rem 0;
    }

    h1 {
      font-size: 2rem;
      line-height: 1.2;
    }

    p {
      font-size: 1rem;
    }

    .hero-dot-grid {
      background-size: 20px 20px;
    }
  }
</style>
