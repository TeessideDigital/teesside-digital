---
import type { ImageMetadata } from "astro";
import ServiceDirectory from "./ServiceDirectory.astro";
import AtmosphericHeroMedia from "./AtmosphericHeroMedia.astro";
import { projectEnquiry, websiteReview } from "@config/navigation";
interface Props {
  image: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
const { image, imageAlt = "", imagePosition = "75% center" } = Astro.props;
---

<section class="home-opening" aria-labelledby="opening-heading">
  <div class="opening-layout">
    <div class="opening-introduction">
      <h1 id="opening-heading">
        <span>Websites,</span>
        <span>business tools and</span>
        <span>practical automation.</span>
      </h1>
      <p class="opening-support">
        For small and owner-led businesses that need a clearer website, a better
        way to handle everyday tasks, or less repetitive work.
      </p>
    </div>
    <AtmosphericHeroMedia
      image={image}
      alt={imageAlt}
      position={imagePosition}
    />
    <ServiceDirectory />
    <div class="opening-context">
      <p>
        <strong>Based in Hartlepool</strong><span
          >Working across Teesside and the North East.</span
        >
      </p>
      <p>
        <strong>Work directly with Dave</strong><span
          >I design and build your project.</span
        >
      </p>
    </div>
    <div class="opening-conversion">
      <a class="opening-primary" href={projectEnquiry.href}
        ><span>{projectEnquiry.label}</span><span
          class="advancing-rule"
          aria-hidden="true"></span><svg
          aria-hidden="true"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><path d="M3 12h17m-7-7 7 7-7 7"></path></svg
        ></a
      >
      <a class="opening-secondary" href={websiteReview.href}
        ><span>{websiteReview.label}</span><svg
          aria-hidden="true"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"><path d="M3 12h17m-7-7 7 7-7 7"></path></svg
        ></a
      >
    </div>
  </div>
</section>
<style>
  .home-opening {
    container: opening / inline-size;
    background: rgb(var(--color-canvas));
  }
  .opening-layout {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 1rem;
    padding: 2rem 1.5rem 3rem;
  }
  .opening-introduction,
  .opening-context,
  .opening-conversion {
    grid-column: 1 / -1;
    min-inline-size: 0;
  }
  .opening-introduction {
    z-index: 1;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.875rem, 12cqi, 3.625rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: rgb(var(--color-text));
    overflow-wrap: anywhere;
  }
  .opening-support {
    max-inline-size: 43ch;
    margin-block: 1.5rem 0;
    color: rgb(var(--color-text-muted));
    font-size: 1.125rem;
    line-height: 1.45;
  }
  .opening-context {
    margin-block-start: 1.5rem;
  }
  .opening-context p {
    padding-block: 1.25rem;
    border-block-end: 1px solid rgb(var(--color-rule));
    color: rgb(var(--color-text-muted));
    font-size: 1rem;
    line-height: 1.5;
  }
  .opening-context strong,
  .opening-context span {
    display: block;
  }
  .opening-context strong {
    color: rgb(var(--color-text));
    font-weight: 500;
    margin-block-end: 0.35rem;
  }
  .opening-conversion {
    margin-block-start: 1.75rem;
  }
  .opening-conversion a {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-block-size: 2.75rem;
    color: rgb(var(--color-text));
  }
  .opening-conversion svg {
    flex: none;
  }
  .opening-primary {
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .advancing-rule {
    flex: 1;
    min-inline-size: 1rem;
    border-block-start: 1px solid currentColor;
  }
  .opening-conversion .opening-secondary {
    inline-size: fit-content;
    gap: 2rem;
    margin-block-start: 0.5rem;
    border-block-end: 1px solid rgb(var(--color-rule));
    color: rgb(var(--color-text-muted));
    font-size: 1rem;
  }
  .opening-conversion a:hover {
    color: rgb(var(--color-action-hover));
  }
  @container opening (min-width: 40rem) {
    .opening-layout {
      padding-inline: 2.5rem;
      gap: 0 1.5rem;
    }
    h1 {
      font-size: clamp(3.625rem, 8.5cqi, 5rem);
    }
    .opening-support {
      font-size: 1.25rem;
    }
  }
  @container opening (min-width: 58rem) {
    .opening-layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      padding: 20rem 3rem 2rem;
      min-block-size: 56.25rem;
    }
    .opening-introduction {
      grid-column: 1 / -1;
    }
    h1 {
      font-size: clamp(5.5rem, 7.4cqi, 6.5rem);
      line-height: 0.95;
      letter-spacing: -0.04em;
    }
    h1 span {
      display: block;
    }
    .opening-support {
      max-inline-size: 55ch;
      margin-block-start: 1.25rem;
      font-size: 1.25rem;
    }
    .opening-context {
      grid-column: 1 / 8;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 1.75rem;
      margin-block-start: 2.5rem;
      align-self: start;
    }
    .opening-context p {
      padding: 0;
      border: 0;
      font-size: 0.8125rem;
    }
    .opening-context p + p {
      padding-inline-start: 1.75rem;
      border-inline-start: 1px solid rgb(var(--color-rule));
    }
    .opening-conversion {
      grid-column: 8 / -1;
      align-self: start;
      margin-block-start: 2.125rem;
    }
    .opening-primary {
      font-size: 1.25rem;
    }
    .opening-conversion .opening-secondary {
      font-size: 0.875rem;
    }
  }
  @media (forced-colors: active) {
    .home-opening {
      background: Canvas;
    }
  }
</style>
