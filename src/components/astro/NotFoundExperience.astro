---
import { SITE } from "@config/constants";
import { projectEnquiry, websiteReview } from "@config/navigation";
import PageOpening from "../system/PageOpening.astro";
import ArrowLink from "../system/ArrowLink.astro";

const links = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services/" },
  projectEnquiry,
  websiteReview,
];
---

<div class="not-found-experience">
  <PageOpening
    label="404"
    title="Page not found"
    lead="This page does not exist, or it has moved."
  />
  <div class="td-section">
    <div class="td-wrap">
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <ArrowLink href={link.href}>{link.label}</ArrowLink>
            </li>
          ))
        }
      </ul>
      <p class="closing">
        If a link on this website brought you here, please email
        <a class="td-link" href={`mailto:${SITE.email}`}>{SITE.email}</a> so it can
        be fixed.
      </p>
    </div>
  </div>
</div>

<style>
  ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .closing {
    margin: 32px 0 0;
    max-inline-size: 660px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-2);
    overflow-wrap: break-word;
  }
  @media (min-width: 48rem) {
    .closing {
      font-size: 1.0625rem;
    }
  }
</style>
