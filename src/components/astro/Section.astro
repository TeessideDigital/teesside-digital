---
/**
 * Section.astro
 *
 * Generic section wrapper used throughout the site.
 * Handles:
 * - Max-width container
 * - Padding (vertical + horizontal)
 * - Optional background color (background, surface, surface-raised)
 * - Optional eyebrow label (small caps, accent colour, bottom border --
 *   the "Meta" typography tier from PLAN.md's Phase 3.5 scale)
 * - Optional section heading
 * - Consistent spacing between sections
 *
 * Props:
 * - background?: 'background' | 'surface' | 'surface-raised'
 * - eyebrow?: string (short category label shown above heading, e.g. "PROCESS")
 * - heading?: string (optional h2 -- stays at its existing prominent size;
 *   the small-caps treatment applies to eyebrow, not this)
 * - subheading?: string (optional subtitle)
 * - id?: string (for anchor links)
 * - class?: string (additional classes)
 */

import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  background?: 'background' | 'surface' | 'surface-raised';
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  id?: string;
}

const {
  background = 'background',
  eyebrow,
  heading,
  subheading,
  id,
  class: customClass = '',
  ...attrs
} = Astro.props as Props;

/**
 * Background color mappings
 */
const backgroundClasses = {
  background: 'bg-background',
  surface: 'bg-surface',
  'surface-raised': 'bg-surface-raised',
};
---

<section
  id={id}
  class={`
    section-padding
    ${backgroundClasses[background]}
    transition-colors duration-200
    ${customClass}
  `}
  {...attrs}
>
  <div class="container-content">
    {/* Optional eyebrow label -- small caps, accent colour, subtle bottom
        border, per PLAN.md's Meta typography tier. Sits above heading,
        does not replace it, so heading keeps its existing visual weight. */}
    {eyebrow && (
      <p class="inline-block text-xs font-semibold uppercase tracking-widest text-accent-text border-b border-accent pb-2 mb-4">
        {eyebrow}
      </p>
    )}

    {/* Optional section heading */}
    {heading && (
      <div class="mb-12 md:mb-16">
        <h2 class="text-h2 text-text-primary mb-3">
          {heading}
        </h2>
        {subheading && (
          <p class="text-lg text-text-secondary max-w-2xl">
            {subheading}
          </p>
        )}
      </div>
    )}

    {/* Section content */}
    <slot />
  </div>
</section>

<style>
  section {
    /* Smooth transitions for background color changes (useful for dark/light mode in future) */
    transition: background-color 0.2s ease-out;
  }

  /**
   * Ensure consistent spacing between sections
   * No margin needed since padding handles spacing
   */
  section {
    margin: 0;
  }
</style>
