---
// Approved destinations. Their target sections arrive with Services consolidation.
const entries = [
  {
    name: "Websites & Web Development",
    href: "/services/#websites-web-development",
    description: "Clear information and routes to enquiry.",
  },
  {
    name: "Apps & Digital Tools",
    href: "/services/#apps-digital-tools",
    description: "Quoting, booking and everyday tasks.",
  },
  {
    name: "Automation & AI",
    href: "/services/#automation-ai",
    description: "Connected systems and repetitive work.",
  },
];
---

<section class="service-directory" aria-labelledby="directory-heading">
  <h2 id="directory-heading" class="sr-only">Services</h2>
  <ul>
    {
      entries.map((entry) => (
        <li>
          <a href={entry.href}>
            <>
              <span class="service-title">{entry.name}</span>
              <span class="service-description">{entry.description}</span>
              <span class="service-direction" aria-hidden="true">
                <>
                  <span class="service-rule" />
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M3 12h17m-7-7 7 7-7 7" />
                  </svg>
                </>
              </span>
            </>
          </a>
        </li>
      ))
    }
  </ul>
</section>
<style>
  .service-directory {
    grid-column: 1 / -1;
    min-inline-size: 0;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    min-inline-size: 0;
  }
  a {
    display: grid;
    padding-block: 1.5rem 0.25rem;
    min-block-size: 2.75rem;
    color: rgb(var(--color-text));
  }
  a:hover {
    color: rgb(var(--color-action-hover));
  }
  .service-title {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .service-description {
    margin-block-start: 0.4rem;
    color: rgb(var(--color-text-muted));
    font-size: 1rem;
    line-height: 1.45;
  }
  .service-direction {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
    color: rgb(var(--color-action));
  }
  .service-rule {
    flex: 1;
    border-block-start: 1px solid rgb(var(--color-rule));
  }
  svg {
    flex: none;
  }
  @container opening (min-width: 58rem) {
    .service-directory {
      margin-block-start: 2.25rem;
    }
    ul {
      display: grid;
      grid-template-columns: 1.05fr 1fr 1fr;
      gap: 2.5rem;
    }
    a {
      padding-block: 0;
      height: 100%;
      grid-template-rows: auto 1fr auto;
    }
    li + li {
      border-inline-start: 1px solid rgb(var(--color-rule) / 0.65);
      padding-inline-start: 2.5rem;
    }
    .service-title {
      font-size: 1rem;
    }
    .service-description {
      font-size: 0.875rem;
    }
    .service-direction {
      margin-block-start: 0.875rem;
    }
  }
</style>
