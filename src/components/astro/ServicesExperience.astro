---
import { projectEnquiry } from "@config/navigation";
import ActionButton from "../system/ActionButton.astro";
import ArrowIcon from "../system/ArrowIcon.astro";
import Band from "../system/Band.astro";
import ClosingPanel from "../system/ClosingPanel.astro";
import NumberedItem from "../system/NumberedItem.astro";
import PageOpening from "../system/PageOpening.astro";
import SectionLabel from "../system/SectionLabel.astro";
import WebsiteVisual from "../visuals/WebsiteVisual.astro";
import BookingVisual from "../visuals/BookingVisual.astro";
import AutomationVisual from "../visuals/AutomationVisual.astro";

// The anchor ids are linked from Home's service cards. Do not rename them.
const contents = [
  {
    title: "Websites & Web Development",
    id: "websites-web-development",
    line: "Clear information and routes to enquiry.",
  },
  {
    title: "Apps & Digital Tools",
    id: "apps-digital-tools",
    line: "Quoting, booking and everyday tasks.",
  },
  {
    title: "Automation & AI",
    id: "automation-ai",
    line: "Connected systems and repetitive work.",
  },
];
const websiteDetails = [
  {
    title: "Business websites",
    description:
      "Clear, responsive sites designed around the information customers actually need.",
  },
  {
    title: "Redesigns and structure",
    description:
      "Improve an existing site when the content, navigation or enquiry journey is getting in the way.",
  },
  {
    title: "Useful integrations",
    description:
      "Connect the site to the systems or services the business already relies on where that genuinely helps.",
  },
];
const toolExamples = [
  "Quoting and admin workflows",
  "Booking and internal processes",
  "Purpose-built business tools",
  "Connecting useful existing systems",
];
const automationExamples = [
  "Repetitive admin",
  "Information / enquiry routing",
  "Data movement / integrations",
  "Summarisation or classification",
];
const disciplines = [
  {
    title: "Performance",
    description:
      "Build for useful speed and responsiveness rather than treating performance as a final optimisation pass.",
  },
  {
    title: "Accessibility",
    description:
      "Make appropriate accessibility decisions during design and implementation rather than bolting them on afterwards.",
  },
  {
    title: "Security",
    description:
      "Use sensible security practices from the beginning, proportionate to the system and the risks involved.",
  },
  {
    title: "Maintainability",
    description:
      "Keep the result understandable and supportable instead of creating unnecessary technical complexity.",
  },
];
---

<div class="services-experience">
  <PageOpening
    label="Services"
    title="Three areas of work. One aim."
    lead="Make the digital side of your business clearer, more useful and easier to run."
  />
  <div class="index">
    <div class="td-wrap">
      <nav aria-label="Services on this page">
        <ul class="index-tiles" role="list">
          {
            contents.map((service, index) => (
              <li class="index-tile">
                <span class="td-label" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <a href={`#${service.id}`}>
                  <span>{service.title}</span>
                  <ArrowIcon />
                </a>
                <p>{service.line}</p>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <section class="td-section" aria-labelledby="websites-web-development">
    <div class="td-wrap service" data-reveal>
      <div class="service-text">
        <SectionLabel>01 / Websites</SectionLabel>
        <h2 class="td-h2" id="websites-web-development" tabindex="-1">
          Websites &amp; Web Development
        </h2>
        <p class="td-lead">
          Clear, fast websites built around what your business actually needs to
          do.
        </p>
        <p class="service-copy">
          A website should make it easier for people to understand your business
          and take the next step. That can mean a new site, a considered
          redesign, clearer information, better enquiry routes or integrations
          that remove unnecessary friction.
        </p>
        <div class="service-details">
          {
            websiteDetails.map((detail) => (
              <div>
                <h3>{detail.title}</h3>
                <p>{detail.description}</p>
              </div>
            ))
          }
        </div>
        <ActionButton href={projectEnquiry.href}>
          {projectEnquiry.label}
        </ActionButton>
      </div>
      <div class="service-media"><WebsiteVisual size="large" /></div>
    </div>
  </section>

  <Band inverse>
    <section class="td-section band-section" aria-labelledby="apps-digital-tools">
      <div class="td-wrap service service--reverse" data-reveal>
        <div class="service-text">
          <SectionLabel>02 / Apps and tools</SectionLabel>
          <h2 class="td-h2" id="apps-digital-tools" tabindex="-1">
            Apps &amp; Digital Tools
          </h2>
          <p class="td-lead">
            Focused tools that replace awkward processes and make everyday work
            easier to manage.
          </p>
          <p class="service-copy">
            Some problems do not need another large software platform. A focused
            internal tool or purpose-built interface can often remove the
            spreadsheet workarounds, duplicated admin and manual handoffs that
            slow a small business down.
          </p>
          <ul class="service-list" role="list">
            {toolExamples.map((example) => <li>{example}</li>)}
          </ul>
          <ActionButton href={projectEnquiry.href}>
            {projectEnquiry.label}
          </ActionButton>
        </div>
        <div class="service-media"><BookingVisual size="large" /></div>
      </div>
    </section>
  </Band>

  <section class="td-section band-section" aria-labelledby="automation-ai">
    <div class="td-wrap service" data-reveal>
      <div class="service-text">
        <SectionLabel>03 / Automation</SectionLabel>
        <h2 class="td-h2" id="automation-ai" tabindex="-1">
          Automation &amp; AI
        </h2>
        <p class="td-lead">
          Practical automation for repetitive work, with AI used where it
          genuinely adds value.
        </p>
        <p class="service-copy">
          The starting point is the repetitive problem, not the technology.
          Automation can move information, route enquiries, connect systems or
          remove routine admin. AI can help with tasks such as summarising or
          classifying information where it is actually appropriate.
        </p>
        <div class="service-position">
          <p class="service-statement">AI is not the product by default.</p>
          <p>
            The aim is to remove useful amounts of repetition without making the
            system unnecessarily complicated.
          </p>
        </div>
        <ul class="service-list" role="list">
          {automationExamples.map((example) => <li>{example}</li>)}
        </ul>
        <ActionButton href={projectEnquiry.href}>
          {projectEnquiry.label}
        </ActionButton>
      </div>
      <div class="service-media"><AutomationVisual size="large" /></div>
    </div>
  </section>

  <Band inverse>
    <section class="td-section band-section" aria-labelledby="engineering-heading">
      <div class="td-wrap pairing" data-reveal>
        <h2 class="td-h2 pairing-head" id="engineering-heading">
          The important engineering details should be part of the work from the
          start.
        </h2>
        <ul class="pairing-list" role="list">
          {
            disciplines.map((discipline, index) => (
              <NumberedItem
                number={String(index + 1).padStart(2, "0")}
                title={discipline.title}
                text={discipline.description}
              />
            ))
          }
        </ul>
      </div>
    </section>
  </Band>

  <section class="td-section band-section" aria-labelledby="fit-heading">
    <div class="td-wrap" data-reveal>
      <div class="td-split">
        <h2 class="td-h2-statement" id="fit-heading">
          Teesside Digital works best with small and owner-led businesses that
          need focused digital work without layers of account management.
        </h2>
        <div class="fit-body">
          <div class="td-prose">
            <p>
              It tends to fit best when you want direct access to the person
              doing the work, have a website or process that is not working as
              well as it should, or need a focused digital solution rather than
              an enormous platform.
            </p>
          </div>
          <ul class="fit-points" role="list">
        <NumberedItem
          title="The goal is appropriate technology, not as much technology as possible."
          text="If a straightforward website solves the problem, that is the right answer. If a small internal tool is enough, it does not need to become a software product. And if AI adds nothing useful, it does not need to be there."
        />
        <NumberedItem
          title="Work directly with Dave."
          text="Design decisions, technical decisions and communication stay connected instead of passing through layers of account management."
        />
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="closing">
    <div class="td-wrap" data-reveal>
      <ClosingPanel
        title="Not sure which you need?"
        text="Tell Dave what your business needs and what is getting in the way. You do not need a technical brief."
      />
    </div>
  </div>
</div>

<style>
  .services-experience {
    color: var(--text);
  }
  /* Index: three tiles in one panel. The name is each tile's link, stretched
     over the tile, so its number and line stay out of the link's name. */
  .index {
    padding-block-end: 56px;
  }
  .index-tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--border);
    overflow: hidden;
  }
  .index-tile {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    align-content: start;
    padding: 20px;
    background: var(--surface);
  }
  .index-tile a,
  .index-tile a:hover {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--text-strong);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .index-tile a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .index-tile a :global(svg) {
    flex: none;
    color: var(--accent-text);
  }
  .index-tile a:focus-visible {
    outline: none;
  }
  .index-tile:has(a:focus-visible) {
    outline: 2px solid var(--accent-text);
    outline-offset: -2px;
  }
  .index-tile:hover {
    background: var(--surface-2);
  }
  .index-tile p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-2);
  }
  @media (prefers-reduced-motion: no-preference) and (forced-colors: none) {
    .index-tile a :global(svg) {
      transition: transform 0.21s var(--td-ease);
    }
    .index-tile:is(:hover, :focus-within) a :global(svg) {
      transform: translateX(7px);
    }
  }

  /* A service: text, then the large drawing beside it. */
  .band-section {
    border-block-start: 0;
  }
  .service {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px var(--td-gap);
    align-items: center;
  }
  .service-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    justify-items: start;
    min-inline-size: 0;
  }
  .service-copy,
  .service-position p,
  .service-details p,
  .service-list li {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-2);
    overflow-wrap: break-word;
  }
  .service-details {
    display: grid;
    gap: 16px;
  }
  .service-details h3,
  .service-position .service-statement {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
  }
  .service-position {
    padding-inline-start: 16px;
    border-inline-start: 2px solid var(--border-strong);
  }
  .service-list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .service-list li {
    position: relative;
    padding-inline-start: 1.75rem;
  }
  .service-list li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.8em;
    inline-size: 0.875rem;
    border-block-start: 1px solid var(--text-3);
  }
  /* The drawing sits in a panel. It is decoration, so it leads on small
     screens without changing the reading order. */
  .service-media {
    order: -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 280px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }
  .service-media :global(.pv) {
    inline-size: 100%;
    max-inline-size: 420px;
  }
  .service-media :global(.pv-website) {
    block-size: 280px;
    max-inline-size: 460px;
  }

  /* A heading on the left and points on the right. */
  .pairing {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px var(--td-gap);
  }
  .pairing-list,
  .fit-points {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 26px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    min-inline-size: 0;
  }
  .fit-points {
    margin-block-start: 32px;
    max-inline-size: 660px;
  }
  .closing {
    padding-block-end: var(--td-section);
  }
  @media (min-width: 48rem) {
    .index {
      padding-block-end: 72px;
    }
    .index-tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .index-tile {
      padding: 26px 28px;
    }
    .index-tile a {
      font-size: 1.25rem;
    }
    .service-copy,
    .service-position p,
    .service-details p,
    .service-list li {
      font-size: 1.0625rem;
    }
    .service-media {
      min-block-size: 360px;
      padding: 36px;
    }
    .pairing-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
    .fit-points {
      margin-block-start: 40px;
    }
  }
  @media (min-width: 64rem) {
    .index {
      padding-block-end: 96px;
    }
    .service {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .service-text {
      grid-column: 1 / span 5;
    }
    .service-media {
      order: 0;
      grid-column: 7 / span 6;
      min-block-size: 440px;
    }
    .service--reverse .service-text {
      grid-column: 8 / span 5;
    }
    .service--reverse .service-media {
      order: -1;
      grid-column: 1 / span 6;
    }
    .service-media :global(.pv-website) {
      block-size: 100%;
      min-block-size: 366px;
      max-inline-size: none;
    }
    .pairing {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .pairing-head {
      grid-column: 1 / span 5;
    }
    .pairing-list {
      grid-column: 7 / span 6;
    }
  }
  @media (forced-colors: active) {
    .index-tile,
    .service-media,
    .service-position {
      border-color: CanvasText;
    }
    .index-tile {
      outline: 1px solid CanvasText;
    }
    .service-list li::before {
      border-color: CanvasText;
    }
  }
</style>
