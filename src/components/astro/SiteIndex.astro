---
import BrandIdentity from "./BrandIdentity.astro";
import ThemeControl from "./ThemeControl.astro";
import {
  primaryNavigation,
  projectEnquiry,
  websiteReview,
  isCurrentPage,
} from "@config/navigation";
const links = [...primaryNavigation, projectEnquiry, websiteReview];
const current = (href: string) =>
  isCurrentPage(Astro.url.pathname, href) ? "page" : undefined;
---

<header class="site-index">
  <div class="site-index-inner" data-site-index>
    <div class="index-bar" data-fit-part>
      <BrandIdentity />
      <button
        class="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-button
        hidden
      >
        <span class="sr-only">Menu</span>
        <svg
          aria-hidden="true"
          width="18"
          height="12"
          viewBox="0 0 18 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"><path d="M0 1h18M0 6h18M0 11h18"></path></svg
        >
      </button>
    </div>
    <div class="index-menu" id="site-menu" data-menu>
      <nav aria-label="Site navigation" data-fit-part>
        <ul>
          {
            links.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="index-utility" data-fit-part><ThemeControl /></div>
    </div>
  </div>
</header>
<script is:inline>
  /* Inline and directly after the menu, so a phone never paints it open first.
   * Without this script the navigation simply stays visible. */
  (() => {
    const button = document.querySelector("[data-menu-button]");
    const menu = document.querySelector("[data-menu]");
    if (!button || !menu) return;
    const root = document.documentElement;
    const isOpen = () => button.getAttribute("aria-expanded") === "true";
    const set = (open) => {
      button.setAttribute("aria-expanded", String(open));
      root.toggleAttribute("data-menu-open", open);
    };
    root.setAttribute("data-menu-ready", "");
    button.hidden = false;
    button.addEventListener("click", () => {
      set(!isOpen());
      if (isOpen()) menu.querySelector("a")?.focus();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !isOpen()) return;
      set(false);
      button.focus();
    });
    // Leaving the phone layout always leaves the menu's closed state behind.
    matchMedia("(min-width: 48rem)").addEventListener("change", () =>
      set(false),
    );
  })();
</script>
<script>
  const index = document.querySelector<HTMLElement>("[data-site-index]");
  if (index && "ResizeObserver" in window) {
    // Measure the three parts' own heights, not the expanded rail, so enabling
    // the tall composition cannot cause a fit/unfit feedback loop. Keep 48px spare.
    const parts = Array.from(
      index.querySelectorAll<HTMLElement>("[data-fit-part]"),
    );
    const updateFit = () => {
      const style = getComputedStyle(index);
      const contentHeight = parts.reduce(
        (height, part) => height + part.getBoundingClientRect().height,
        0,
      );
      const minimumHeight =
        contentHeight +
        parseFloat(style.paddingTop) +
        parseFloat(style.paddingBottom) +
        (parseFloat(style.rowGap) || 0) * (parts.length - 1);
      index.toggleAttribute(
        "data-fits",
        window.innerHeight - minimumHeight >= 48,
      );
    };
    const observer = new ResizeObserver(updateFit);
    observer.observe(index);
    parts.forEach((part) => observer.observe(part));
    window.addEventListener("resize", updateFit, { passive: true });
    window.addEventListener("pageshow", updateFit);
    updateFit();
  }
</script>
<style>
  .site-index {
    min-inline-size: 0;
    background: var(--bg-deep);
    border-block-end: 1px solid var(--border);
    color: var(--text);
  }
  .site-index-inner {
    display: flex;
    flex-direction: column;
    padding: 0 20px;
  }
  .index-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-block-size: 64px;
  }
  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: transparent;
    color: var(--text);
  }
  .menu-button[hidden] {
    display: none;
  }
  .menu-button:focus {
    box-shadow: none;
  }
  .menu-button[aria-expanded="true"] {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }
  .index-menu {
    padding-block: 4px 16px;
    border-block-start: 1px solid var(--border);
  }
  ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a,
  nav a:hover {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  nav a:hover {
    color: var(--accent-text-hover);
  }
  /* Weight as well as colour, so the current page is not marked by colour alone. */
  nav a[aria-current="page"] {
    color: var(--accent-text);
    font-weight: 600;
  }
  .index-utility {
    margin-block-start: 8px;
    padding-block-start: 8px;
    border-block-start: 1px solid var(--border);
  }
  /* The menu button pattern is for phones. It only collapses once its script ran. */
  @media (max-width: 47.999rem) {
    :global(:root[data-menu-ready]) .index-menu {
      display: none;
    }
    :global(:root[data-menu-ready][data-menu-open]) .index-menu {
      display: block;
    }
  }
  @media (min-width: 48rem) {
    .menu-button {
      display: none;
    }
  }
  @media (min-width: 48rem) and (max-width: 74.999rem) {
    .site-index-inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 32px;
      padding: 8px 40px;
    }
    .index-menu {
      display: flex;
      flex: 1;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 0 32px;
      padding: 0;
      border: 0;
    }
    ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 24px;
    }
    .index-utility {
      margin: 0;
      padding: 0;
      border: 0;
    }
  }
  @media (min-width: 75rem) {
    .site-index {
      border-block-end: 0;
      border-inline-end: 1px solid var(--border);
    }
    .site-index-inner {
      padding: 40px 32px 32px;
      row-gap: 40px;
    }
    .index-bar {
      min-block-size: 0;
    }
    .index-menu {
      display: contents;
    }
    ul {
      gap: 0;
    }
    .index-utility {
      margin: 0;
      padding: 0;
      border: 0;
    }
    @media (min-height: 40rem) {
      .site-index-inner[data-fits] {
        position: sticky;
        inset-block-start: 0;
        min-block-size: 100svh;
      }
      .site-index-inner[data-fits] .index-utility {
        margin-block-start: auto;
      }
    }
  }
  @media (forced-colors: active) {
    .menu-button {
      border-color: ButtonText;
    }
    nav a[aria-current="page"] {
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }
  }
  @media print {
    .site-index-inner[data-fits] {
      position: static;
      min-block-size: auto;
    }
  }
</style>
