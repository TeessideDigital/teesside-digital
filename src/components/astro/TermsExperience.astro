---
import { SITE } from "@config/constants";
import PageOpening from "../system/PageOpening.astro";
---

<div class="terms-experience">
  <PageOpening
    label="Terms"
    title="Terms"
    lead="These terms cover your use of this website. They do not cover project work: anything Teesside Digital does for you is agreed separately, in writing."
  >
    <p>Last updated: 13 October 2026</p>
  </PageOpening>
  <div class="td-section">
    <div class="td-wrap">
      <section class="td-split" aria-labelledby="who-heading">
        <h2 class="td-h2-statement" id="who-heading">Who runs this website</h2>
        <div class="td-prose">
          <p>
            This website is run by David Young, trading as Teesside Digital, a
            sole trader.
          </p>
          <p>Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <!-- TODO: add full postal address when a business address service is set up -->
          <p>Based in Hartlepool, Teesside.</p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="using-heading">
        <h2 class="td-h2-statement" id="using-heading">Using this website</h2>
        <div class="td-prose">
          <p>You are welcome to read this website and share links to it.</p>
          <p>
            Please do not try to break or bypass its security, overload it, add
            malicious code, or use the forms to send automated or bulk
            submissions.
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="content-heading">
        <h2 class="td-h2-statement" id="content-heading">Content</h2>
        <div class="td-prose">
          <p>
            The text and design of this website belong to Teesside Digital unless
            stated otherwise. You may quote short passages with a credit and a
            link. Please ask before reusing anything more.
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="accuracy-heading">
        <h2 class="td-h2-statement" id="accuracy-heading">Accuracy</h2>
        <div class="td-prose">
          <p>
            The information on this website is general. It describes the kind of
            work Teesside Digital does, and is not advice about your particular
            situation until that has been discussed and agreed.
          </p>
          <p>
            Dave aims to keep it accurate and up to date, but cannot guarantee
            that it always is.
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="links-heading">
        <h2 class="td-h2-statement" id="links-heading">Links to other websites</h2>
        <div class="td-prose">
          <p>
            This website links to a few other websites, such as Netlify, Zoho and
            the Information Commissioner's Office. Teesside Digital is not
            responsible for their content.
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="liability-heading">
        <h2 class="td-h2-statement" id="liability-heading">Liability</h2>
        <div class="td-prose">
          <p>
            Nothing in these terms limits any liability that cannot be limited by
            law, such as liability for death or personal injury caused by
            negligence, or for fraud.
          </p>
          <p>
            Otherwise, Teesside Digital is not liable for any loss arising from
            your use of this website or from relying on its content. This does
            not affect your legal rights as a consumer.
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="privacy-heading">
        <h2 class="td-h2-statement" id="privacy-heading">Privacy</h2>
        <div class="td-prose">
          <p>
            How information you send through this website is handled is explained
            in the privacy notice.
            <a href="/privacy/">Read the privacy notice</a>
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="changes-heading">
        <h2 class="td-h2-statement" id="changes-heading">Changes and law</h2>
        <div class="td-prose">
          <p>
            These terms may be updated. The date at the top shows when they last
            changed.
          </p>
          <p>
            These terms are governed by the law of England and Wales. If you live
            in Scotland or Northern Ireland, you can also bring proceedings in
            your local courts.
          </p>
        </div>
      </section>
    </div>
  </div>
</div>
