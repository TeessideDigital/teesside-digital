<fieldset class="theme-control" data-theme-control hidden>
  <legend class="sr-only">Colour theme</legend>
  <label
    ><input type="radio" name="colour-theme" value="dark" checked /> Dark</label
  >
  <label><input type="radio" name="colour-theme" value="light" /> Light</label>
</fieldset>
<script>
  type Theme = "dark" | "light";
  const api = (
    window as Window & {
      TeessideTheme?: {
        get(): Theme;
        set(theme: Theme): { theme: Theme; persisted: boolean };
      };
    }
  ).TeessideTheme;
  const control = document.querySelector<HTMLFieldSetElement>(
    "[data-theme-control]",
  );
  if (api && control) {
    const choices = control.querySelectorAll<HTMLInputElement>("input");
    const sync = () =>
      choices.forEach((choice) => {
        choice.checked = choice.value === api.get();
      });
    control.addEventListener("change", (event) => {
      const choice = event.target;
      if (
        choice instanceof HTMLInputElement &&
        (choice.value === "dark" || choice.value === "light")
      ) {
        api.set(choice.value);
        sync();
      }
    });
    sync();
    control.hidden = false;
    window.addEventListener("pageshow", sync);
    new MutationObserver(sync).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }
</script>
<style>
  .theme-control {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    color: var(--text-2);
    font-size: 0.875rem;
  }
  .theme-control[hidden] {
    display: none;
  }
  label {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-block-size: 2.75rem;
    cursor: pointer;
  }
  .theme-control input[type="radio"] {
    appearance: none;
    display: grid;
    place-content: center;
    inline-size: 1rem;
    block-size: 1rem;
    flex: none;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: transparent;
    color: var(--text-2);
    cursor: pointer;
  }
  input::before {
    content: "";
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    visibility: hidden;
  }
  input:checked::before {
    visibility: visible;
  }
  .theme-control input:checked {
    color: var(--accent-text);
  }
  label:has(:checked) {
    color: var(--text);
  }
  @media (forced-colors: active), (prefers-contrast: more) {
    .theme-control input[type="radio"] {
      appearance: auto;
      accent-color: auto;
      border: revert;
      background: revert;
      color: revert;
    }
    input::before {
      content: none;
    }
  }
</style>
