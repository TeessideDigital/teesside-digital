---
import { projectEnquiry } from "@config/navigation";
import WebsiteReviewForm from "./WebsiteReviewForm.astro";
import PageOpening from "../system/PageOpening.astro";
import ArrowLink from "../system/ArrowLink.astro";

const looksAt = [
  "First impression, and how clearly the site explains what you offer",
  "The key pages a customer needs to understand your business and make contact",
  "How the site works on a phone, and how easy it is to find your way around",
  "The route to making an enquiry",
  "Obvious accessibility barriers",
  "Performance observations, with how and when they were measured if figures are given",
  "Obvious technical or security concerns visible from the public site",
];
const excludes = [
  "Every page of the site",
  "Your hosting, backend or source code, unless separately agreed",
  "Penetration testing or vulnerability scanning",
  "A formal accessibility audit or WCAG certification",
  "A compliance assessment",
  "A comprehensive security review",
  "An SEO campaign or audit",
  "Fixing the issues it finds",
  "Any guarantee of business results",
];
---

<div class="review-experience">
  <PageOpening
    label="Free website review"
    title="Free website review"
    lead="Dave reviews your website and emails you a structured report explaining the main issues he observes and the improvements worth considering."
  >
    <p>
      Free of charge, and reviewed by hand by Dave rather than an automated
      scanner.
    </p>
    <div>
      <p>There is no fixed turnaround. Each report is emailed personally.</p>
      <p><a class="td-link" href="#request">Go to the request form</a></p>
    </div>
  </PageOpening>
  <div class="td-section">
    <div class="td-wrap">
      <section class="td-split" aria-labelledby="looks-heading">
        <h2 class="td-h2-statement" id="looks-heading">What Dave looks at</h2>
        <div class="td-prose">
          <p>
            The review covers the main public-facing website and the route a
            customer takes to get in touch. It may include:
          </p>
          <ul role="list">
            {looksAt.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>
      <section class="td-split" aria-labelledby="receive-heading">
        <h2 class="td-h2-statement" id="receive-heading">What you receive</h2>
        <div class="td-prose">
          <p>
            A written report by email. It separates what Dave observed, the
            evidence for it and the limits of the review, then sets out the
            improvements worth considering in priority order, with why each one
            matters.
          </p>
          <p>
            It should be useful whether or not you go on to work with Teesside
            Digital.
          </p>
          <p>
            If nothing significant turns up, the report says so. That is not a
            guarantee that no issues exist.
          </p>
        </div>
      </section>
      <section class="td-split" aria-labelledby="excludes-heading">
        <h2 class="td-h2-statement" id="excludes-heading">
          What it does not include
        </h2>
        <div class="td-prose">
          <ul role="list">
            {excludes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>
    </div>
  </div>
  {/* The form carries the "Request a review" name, so this wrapper is not a second landmark. */}
  <div class="td-section">
    <div class="td-wrap">
      <div class="td-split">
        <h2 class="td-h2-statement" id="request" tabindex="-1">
          Request a review
        </h2>
        <div><WebsiteReviewForm /></div>
      </div>
    </div>
  </div>
  <section class="td-section alternative" aria-label="Project enquiry">
    <div class="td-wrap">
      <p>Already know what you need?</p>
      <ArrowLink href={projectEnquiry.href}>{projectEnquiry.label}</ArrowLink>
    </div>
  </section>
</div>

<style>
  #request {
    /* Keeps the focus outline clear of the section rule above. */
    scroll-margin-block-start: 24px;
  }
  /* A quieter close than a full section. */
  .alternative {
    padding-block: 40px 56px;
  }
  .alternative p {
    margin: 0 0 4px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-2);
  }
  @media (min-width: 48rem) {
    .alternative {
      padding-block: 48px 72px;
    }
    .alternative p {
      font-size: 1.0625rem;
    }
  }
</style>
