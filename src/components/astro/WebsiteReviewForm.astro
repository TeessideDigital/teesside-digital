---
// Review request form. Without JavaScript the browser validates and posts it
// natively; the shared engine only replaces that with accessible, truthful
// states. The copy the engine shows lives here, beside the fields it describes.
import { SITE } from "@config/constants";
import "../../styles/forms.css";
import ArrowIcon from "../system/ArrowIcon.astro";
---

<form
  class="site-form review-form"
  aria-labelledby="request"
  name="website-review"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-sending="Sending your review request..."
  data-rejected={`Your review request was not sent. Please try again, or email Dave at ${SITE.email}.`}
  data-uncertain={`The website could not confirm whether your review request was received. To check, email Dave at ${SITE.email}. Sending again may create a duplicate.`}
>
  <input type="hidden" name="form-name" value="website-review" />
  <div hidden>
    <label for="review-bot-field">Leave this field empty</label>
    <input
      id="review-bot-field"
      name="bot-field"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <div class="fields">
    <div
      class="status error-summary"
      data-state="error"
      role="group"
      aria-labelledby="review-summary-heading"
      tabindex="-1"
      hidden
    >
      <h3 id="review-summary-heading">Some details need attention</h3>
      <ul></ul>
    </div>
    <p class="form-note measure">
      Please request a review only for a website you own or are responsible
      for. The review looks at the public site only, so never send passwords or
      login details.
    </p>
    <p class="form-note required-note">
      All fields are required unless marked optional.
    </p>
    <div class="pair">
      <div class="field">
        <label for="review-name">Name</label>
        <input
          id="review-name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="100"
          required
          data-missing="Enter your name."
        />
        <p class="field-message" id="review-name-error" hidden></p>
      </div>
      <div class="field">
        <label for="review-email">Email address</label>
        <p class="hint" id="review-email-hint">
          Dave will send the report to this address.
        </p>
        <input
          id="review-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby="review-email-hint"
          data-missing="Enter an email address so Dave can send the report."
          data-format="Enter an email address in the format name@example.com."
        />
        <p class="field-message" id="review-email-error" hidden></p>
      </div>
    </div>
    <div class="field half">
      <label for="review-website">Website address</label>
      <p class="hint" id="review-website-hint">
        The site you want reviewed, for example example.co.uk.
      </p>
      <input
        id="review-website"
        name="website"
        type="text"
        inputmode="url"
        autocomplete="url"
        maxlength="300"
        required
        aria-describedby="review-website-hint"
        data-rule="website"
        data-missing="Enter the address of the website you want reviewed."
        data-format="Enter a website address like example.co.uk."
      />
      <p class="field-message" id="review-website-error" hidden></p>
    </div>
    <div class="field">
      <label for="review-message"
        >Anything you would like Dave to look at? (optional)</label
      >
      <p class="hint" id="review-message-hint">
        For example, what the site is for, what is not working as well as you
        would like, or the pages that matter most.
      </p>
      <textarea
        id="review-message"
        name="message"
        rows="6"
        maxlength="3000"
        aria-describedby="review-message-hint"></textarea>
    </div>
    <div class="privacy measure">
      <p>
        Dave will use these details to carry out the review and email you the
        report.
      </p>
      <p><a href="/privacy/">Read the privacy notice</a></p>
    </div>
    <div>
      <button class="submit td-button td-button--primary" type="submit">
        <span>Send review request</span>
        <ArrowIcon />
      </button>
      <div class="status status-region" role="status" aria-live="polite"></div>
    </div>
  </div>
  <div class="status confirmation" data-state="success" hidden>
    <h3 tabindex="-1">Review request received</h3>
    <p>
      Your review request has been received. Dave will review the website and
      email you the report.
    </p>
    <p>
      If you need to add anything, email <a href={`mailto:${SITE.email}`}
        >{SITE.email}</a
      >.
    </p>
  </div>
</form>

<script>
  import { initForm } from "../../scripts/form-submission";
  initForm(document.querySelector("form.review-form"));
</script>
