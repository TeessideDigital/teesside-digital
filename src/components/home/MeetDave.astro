---
import Icon from "../ui/Icon.astro";
import PhotoSlot from "../ui/PhotoSlot.astro";
---

<section class="block" id="meet">
  <div class="wrap meet">
    <PhotoSlot id="meet" class="reveal" />
    <div class="reveal">
      <span class="label"><i></i>Who you'll work with</span>
      <h2 style="margin-top:22px">Hi, I'm Dave.</h2>
      <p>
        I run Teesside Digital from Hartlepool. When you get in touch, you talk to the person who'll
        actually build it.
      </p>
      <a href="/about/" class="textlink">More about me <Icon name="arrow" /></a>
    </div>
  </div>
</section>
