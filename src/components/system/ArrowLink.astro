---
// Accent text with an arrow that advances on hover and focus.
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  href: string;
  class?: string;
}
const { href, class: extra } = Astro.props;
---

<a class:list={["td-arrow-link", extra]} href={href}>
  <span><slot /></span>
  <ArrowIcon />
</a>
