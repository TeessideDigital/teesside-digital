---
// A panel divided into cells. True facts only, never unsupported statistics.
// "titled" puts an accent title above a line; "labelled" puts a mono label
// above a value.
interface Props {
  facts: { term: string; detail: string }[];
  variant?: "titled" | "labelled";
}
const { facts, variant = "titled" } = Astro.props;
---

<div class="td-facts-wrap">
  <dl
    class:list={["td-facts", variant === "labelled" && "td-facts--labelled"]}
    style={`--td-facts-count: ${facts.length}`}
  >
    {
      facts.map((fact) => (
        <div>
          <dt class="td-facts__term">{fact.term}</dt>
          <dd class="td-facts__detail">{fact.detail}</dd>
        </div>
      ))
    }
  </dl>
</div>
