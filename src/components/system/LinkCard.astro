---
// A card with one link: its title. The link is stretched over the whole card,
// so the description and the arrow label stay out of its accessible name.
// The default slot is the media area, for a decorative product visual.
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
  href: string;
  title: string;
  text: string;
  more: string;
}
const { href, title, text, more } = Astro.props;
---

<article class="td-card">
  <div class="td-card__media"><slot /></div>
  <div class="td-card__body">
    <h3 class="td-card__title"><a href={href}>{title}</a></h3>
    <p class="td-card__text">{text}</p>
    <p class="td-card__more" aria-hidden="true">
      <span>{more}</span>
      <ArrowIcon />
    </p>
  </div>
</article>
