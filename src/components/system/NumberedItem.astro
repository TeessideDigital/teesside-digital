---
// A principle: a title and an optional line under a rule. With a number it is
// the numbered item (mono number, accent rule); without one it is a plain item
// under a quiet rule, for points that are not a sequence.
interface Props {
  number?: string;
  title: string;
  text?: string;
}
const { number, title, text } = Astro.props;
---

<li class:list={["td-numbered", !number && "td-numbered--plain"]}>
  {
    number && (
      <span class="td-numbered__number" aria-hidden="true">
        {number}
      </span>
    )
  }
  <h3 class="td-numbered__title">{title}</h3>
  {text && <p class="td-numbered__text">{text}</p>}
</li>
