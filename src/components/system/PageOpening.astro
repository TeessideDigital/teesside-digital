---
// The opening every page shares: mono label, serif H1, lead, then an optional
// row of facts passed as children.
import SectionLabel from "./SectionLabel.astro";

interface Props {
  label: string;
  title: string;
  lead: string;
}
const { label, title, lead } = Astro.props;
// A label that only repeats the H1 is decoration for assistive technology.
const repeats = label.trim().toLowerCase() === title.trim().toLowerCase();
---

<header class="td-opening">
  <div class="td-wrap">
    <div class="td-opening__main td-grid">
      <div class="td-opening__title">
        <SectionLabel hidden={repeats}>{label}</SectionLabel>
        <h1 class="td-h1">{title}</h1>
      </div>
      <p class="td-opening__lead td-lead">{lead}</p>
    </div>
    {
      Astro.slots.has("default") && (
        <div class="td-opening__facts">
          <slot />
        </div>
      )
    }
  </div>
</header>
