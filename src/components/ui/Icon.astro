---
// The few line icons the site uses. All decorative: the control they sit in
// carries the accessible name.
interface Props {
  name: "arrow" | "phone" | "plus" | "close" | "up" | "tick" | "slider";
  class?: string;
}
const { name, class: className } = Astro.props;
---

{
  name === "arrow" && (
    <svg class={className} width="16" height="12" viewBox="0 0 16 12" aria-hidden="true" focusable="false">
      <path d="M1 6h13M9 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}
{
  name === "phone" && (
    <svg class={className} width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
        fill="currentColor"
      />
    </svg>
  )
}
{
  name === "plus" && (
    <svg class={className} width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false">
      <path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.4" />
    </svg>
  )
}
{
  name === "close" && (
    <svg class={className} width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
      <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )
}
{
  name === "up" && (
    <svg class={className} width="12" height="16" viewBox="0 0 12 16" aria-hidden="true" focusable="false">
      <path d="M6 15V2M1 7l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}
{
  name === "tick" && (
    <svg class={className} width="26" height="20" viewBox="0 0 26 20" aria-hidden="true" focusable="false">
      <path d="M2 10l7 7L24 2" fill="none" stroke="currentColor" stroke-width="3" />
    </svg>
  )
}
{
  name === "slider" && (
    <svg class={className} width="22" height="14" viewBox="0 0 22 14" aria-hidden="true" focusable="false">
      <path d="M6 1L1 7l5 6M16 1l5 6-5 6" fill="none" stroke="currentColor" stroke-width="2" />
    </svg>
  )
}
