---
// Decorative drawing of an automation flow: two finished steps and the current
// one. Pure HTML and CSS: no image, nothing focusable, hidden from assistive
// technology. Each mark carries data-pv-mark so a page may reveal them in turn.
import "../../styles/product-visuals.css";

interface Props {
  size?: "compact" | "large";
  class?: string;
}
const { size = "compact", class: extra } = Astro.props;
const steps = [
  { text: "New enquiry received", note: "From your website form" },
  { text: "Added to your records", note: "No retyping" },
  {
    text: "Reply drafted",
    more: " for you to check",
    note: "You stay in control",
    current: true,
  },
];
---

<div
  class:list={["pv", "pv-automation", `pv--${size}`, extra]}
  aria-hidden="true"
>
  {size === "compact" && <span class="pv-label">Automation</span>}
  <div class="pv-steps">
    {
      steps.map((step) => (
        <div class:list={["pv-step", step.current && "pv-step--current"]}>
          <span class="pv-step__mark" data-pv-mark>
            {!step.current && (
              <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
                <path d="M1 4l3 3 5-6" stroke="currentColor" stroke-width="1.5" />
              </svg>
            )}
          </span>
          <span class="pv-step__text">
            <span>
              {step.text}
              {step.more && <span class="pv-step__more">{step.more}</span>}
            </span>
            <span class="pv-step__note">{step.note}</span>
          </span>
        </div>
      ))
    }
  </div>
</div>
