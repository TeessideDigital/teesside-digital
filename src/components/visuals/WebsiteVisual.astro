---
// Decorative drawing of a small-business website in a browser window.
// Pure HTML and CSS: no image, nothing focusable, hidden from assistive technology.
import "../../styles/product-visuals.css";

interface Props {
  size?: "compact" | "large";
  class?: string;
}
const { size = "compact", class: extra } = Astro.props;
---

<div class:list={["pv", "pv-website", `pv--${size}`, extra]} aria-hidden="true">
  <div class="pv-chrome">
    <span class="pv-dot"></span><span class="pv-dot"></span><span class="pv-dot"
    ></span>
    <span class="pv-address">yourbusiness.co.uk</span>
  </div>
  <div class="pv-nav">
    <span class="pv-bar pv-bar--heading" style="inline-size:70px"></span>
    <span>
      <span class="pv-bar" style="inline-size:40px"></span>
      <span class="pv-bar" style="inline-size:40px"></span>
      <span class="pv-bar" style="inline-size:40px"></span>
    </span>
  </div>
  <div class="pv-page">
    <div class="pv-copy">
      <span class="pv-bar" style="inline-size:40%"></span>
      <span class="pv-bar pv-bar--heading" style="inline-size:100%"></span>
      <span class="pv-bar pv-bar--heading" style="inline-size:76%"></span>
      <span class="pv-bar" style="inline-size:92%;margin-block-start:4px"></span>
      <span class="pv-bar" style="inline-size:84%"></span>
      <span class="pv-bar" style="inline-size:60%"></span>
      <div class="pv-actions">
        <span class="pv-block pv-block--accent"></span>
        <span class="pv-block"></span>
      </div>
    </div>
    <div class="pv-image"></div>
  </div>
</div>
