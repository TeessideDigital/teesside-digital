---
/**
 * BaseLayout.astro
 *
 * Main page wrapper for all pages.
 * Handles:
 * - SiteIndex shell and Footer
 * - Meta tags (title, description, Open Graph)
 * - Structured data (schema.org)
 * - Accessibility (skip to main, lang attribute)
 * - Security headers (via netlify.toml, but verified here)
 *
 * All pages inherit from this layout.
 *
 * Usage:
 * ---
 * import BaseLayout from '@layouts/BaseLayout.astro';
 * ---
 * <BaseLayout title="Page Title" description="Page description">
 *   <YourContent />
 * </BaseLayout>
 */

import { SITE } from "@config/constants";
import {
  getCanonicalUrl,
  getPageTitle,
  getOgImageUrl,
  getOrganisationSchema,
} from "@lib/seo";
import SiteIndex from "../components/astro/SiteIndex.astro";
import Footer from "../components/astro/Footer.astro";
import ActionBar from "../components/astro/ActionBar.astro";
import CallPill from "../components/astro/CallPill.astro";
import { isCurrentPage, projectEnquiry, websiteReview } from "@config/navigation";
import themeScript from "../scripts/theme.js?raw";
import "@styles/tokens.css";
import "@styles/globals.css";
import "@styles/system.css";

interface Props {
  editorialFooter?: boolean;
  title?: string; // Page title (will be appended with site name)
  description?: string; // Meta description
  image?: string; // Open Graph image
  imageAlt?: string; // Image alt text
  canonical?: string; // Canonical URL (optional, auto-generated if not provided)
  robots?: string; // robots meta tag (default: index, follow)
  article?: {
    // For article/case study pages
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
  };
  structuredData?: Record<string, unknown>; // Additional JSON-LD schema
}

const {
  editorialFooter = false,
  title = SITE.title,
  description = SITE.description,
  image,
  imageAlt = SITE.title,
  canonical,
  robots = "index, follow",
  article,
  structuredData,
} = Astro.props as Props;

// The phone-width action bar is left off the two pages whose form is the action.
const showActionBar = ![projectEnquiry.href, websiteReview.href].some((href) =>
  isCurrentPage(Astro.url.pathname, href),
);

// Generate canonical URL
const canonicalUrl = canonical || getCanonicalUrl(Astro.url.pathname);

// Format page title (append site name unless it's the homepage)
const pageTitle = getPageTitle(title);

// Generate Open Graph image URL (must be absolute)
const ogImage = getOgImageUrl(image);

// Base structured data (organisation schema)
const baseStructuredData = getOrganisationSchema();

// Combine with page-specific structured data if provided
const allStructuredData = structuredData
  ? [baseStructuredData, structuredData]
  : baseStructuredData;
---

<!doctype html>
<html lang={SITE.language} data-theme="dark">
  <head>
    {
      /* ============================================================
        Core Meta Tags
        ============================================================ */
    }
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline set:html={themeScript} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    {/* Page Title and Description */}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    {/* Canonical URL (prevents duplicate content issues) */}
    <link rel="canonical" href={canonicalUrl} />

    {
      /* ============================================================
        Open Graph (Social Media)
        ============================================================ */
    }
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={article ? "article" : "website"} />

    {/* Article-specific meta tags */}
    {
      article && article.publishedTime && (
        <meta
          property="article:published_time"
          content={article.publishedTime}
        />
      )
    }
    {
      article && article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime} />
      )
    }
    {
      article && article.author && (
        <meta property="article:author" content={article.author} />
      )
    }

    {
      /* ============================================================
        Twitter Card
        ============================================================ */
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      /* ============================================================
        Favicons & App Icons
        ============================================================ */
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      /* ============================================================
        Fonts
        ============================================================ */
    }
    {
      /* Body and interface text, then the serif used by every page heading. */
    }
    <link
      rel="preload"
      href="/fonts/instrument-sans/instrument-sans-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif/instrument-serif-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      /* ============================================================
        Structured Data (JSON-LD)
        ============================================================ */
    }
    {
      allStructuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(
            Array.isArray(allStructuredData)
              ? {
                  "@context": "https://schema.org",
                  "@graph": allStructuredData,
                }
              : allStructuredData,
          )}
        />
      )
    }

    {
      /* ============================================================
        Analytics (Phase 2: add Fathom when needed)
        ============================================================ */
    }
    {
      /*
      Fathom Analytics placeholder for Phase 2. Do not write this as a
      literal inline script tag inside this comment -- see the note on
      the Sentry placeholder below for why. When Phase 2 needs this, add
      the Fathom snippet via its own small component instead of inline
      here, with a real site ID (not a placeholder) before it ships.
    */
    }
  </head>

  <body class:list={{ "has-action-bar": showActionBar }}>
    {
      /* ============================================================
        Skip to Main Content (Accessibility)
        ============================================================ */
    }
    <a href="#main" class="td-skip">Skip to main content</a>

    {
      /* ============================================================
        SiteIndex and main document shell
        ============================================================ */
    }
    <div class="site-shell">
      <SiteIndex />

      {
        /* ============================================================
        Main Content
        ============================================================ */
      }
      <div class="site-field">
        <main id="main" tabindex="-1">
          <slot />
        </main>
        <Footer editorial={editorialFooter} />
      </div>
    </div>
    {showActionBar && <ActionBar />}
    <CallPill />

    {
      /* ============================================================
        Error Tracking (Phase 2: add Sentry when needed)
        ============================================================ */
    }
    {
      /*
      Sentry placeholder for Phase 2. Do not write this as a literal
      inline script tag inside this comment: Astro's HTML tokenizer
      treats a literal script-tag name as a real raw-text element
      boundary regardless of surrounding comment syntax, which breaks
      the build (this exact bug caused a "Failed to scan for
      dependencies" error -- see the note in PLAN.md/troubleshooting
      if it recurs). When Phase 2 needs this, add the Sentry
      initialisation via its own small component or inside
      BaseLayout.astro's head content instead of inline here.
    */
    }
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .site-shell {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  /* The page and its footer share the column beside the rail. */
  .site-field {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }
  .site-field > main {
    flex: 1;
    min-inline-size: 0;
  }
  /* Keep anything scrolled or focused clear of the fixed action bar. */
  @media (max-width: 47.999rem) {
    :root:has(body.has-action-bar) {
      scroll-padding-block-end: 88px;
    }
  }
  @media (min-width: 75rem) {
    .site-shell {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }
</style>
