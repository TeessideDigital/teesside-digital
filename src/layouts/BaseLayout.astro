---
/**
 * The page wrapper every route uses: metadata, fonts, the head script and the
 * V4 shell (progress bar, floating nav, menu, footer, mobile action bar).
 */
import { SITE } from "@config/constants";
import {
  getCanonicalUrl,
  getPageTitle,
  getOgImageUrl,
  getOrganisationSchema,
} from "@lib/seo";
import headScript from "../scripts/head.js?raw";
import "@styles/tokens.css";
import "@styles/base.css";

interface Props {
  title?: string; // Page title (the site name is appended)
  description?: string;
  image?: string; // Social image, if not the default
  imageAlt?: string;
  canonical?: string;
  robots?: string;
  structuredData?: Record<string, unknown>; // Extra JSON-LD for this page
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  imageAlt = "The Teesside Digital mark: a white T and a lime D on a dark background.",
  canonical,
  robots = "index, follow",
  structuredData,
} = Astro.props as Props;

// A page that is not to be indexed has no canonical. Every other page's
// canonical is its own address, which always ends in a slash.
const canonicalUrl = /noindex/.test(robots)
  ? undefined
  : canonical || getCanonicalUrl(Astro.url.pathname);
const pageTitle = getPageTitle(title);
const ogImage = getOgImageUrl(image);
const baseStructuredData = getOrganisationSchema();
const allStructuredData = structuredData
  ? { "@context": "https://schema.org", "@graph": [baseStructuredData, structuredData] }
  : baseStructuredData;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0d0f" />
    <script is:inline set:html={headScript} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* One variable file holds every weight of the display face, 700 included. */}
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(allStructuredData)}
    />
  </head>

  <body>
    <a href="#main" class="skip">Skip to main content</a>
    <div class="grain" aria-hidden="true"></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
