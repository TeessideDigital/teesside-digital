---
/**
 * src/pages/404.astro
 *
 * 404 error page - displayed when a route is not found.
 *
 * Route: Automatic, displayed for missing routes
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '../components/astro/Section.astro';
import Button from '../components/astro/Button.astro';

const title = 'Page Not Found - Teesside Digital';
const description = 'The page you are looking for could not be found.';

// Set status code for proper 404 response
Astro.response.status = 404;
---

<BaseLayout title={title} description={description}>
  <Section class="py-24 md:py-32 flex items-center justify-center">
    <div class="max-w-2xl mx-auto px-4 md:px-6 text-center">
      <!-- 404 Display -->
      <div class="mb-8">
        <h1 class="text-6xl md:text-7xl font-bold text-accent mb-2">404</h1>
        <p class="text-text-secondary">This page could not be found</p>
      </div>

      <!-- Error Message -->
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-semibold text-text-primary mb-4">
          Page Not Found
        </h2>
        <p class="text-text-secondary text-lg">
          The page you are looking for might have been removed, had its name changed, or is
          temporarily unavailable. Let us help you get back on track.
        </p>
      </div>

      <!-- Suggestions -->
      <div class="p-8 bg-surface-raised rounded mb-8">
        <h3 class="text-lg font-semibold text-text-primary mb-4">Here are some helpful links:</h3>
        <div class="grid md:grid-cols-2 gap-4 text-left text-text-secondary text-sm">
          <a
            href="/"
            class="p-3 bg-surface rounded hover:bg-background transition-colors text-accent hover:text-accent-hover"
          >
            <span class="font-medium">Homepage</span>
            <br />
            <span class="text-xs">Back to the main page</span>
          </a>
          <a
            href="/services"
            class="p-3 bg-surface rounded hover:bg-background transition-colors text-accent hover:text-accent-hover"
          >
            <span class="font-medium">Services</span>
            <br />
            <span class="text-xs">Explore what we offer</span>
          </a>
          <a
            href="/work"
            class="p-3 bg-surface rounded hover:bg-background transition-colors text-accent hover:text-accent-hover"
          >
            <span class="font-medium">Portfolio</span>
            <br />
            <span class="text-xs">See our case studies</span>
          </a>
          <a
            href="/about"
            class="p-3 bg-surface rounded hover:bg-background transition-colors text-accent hover:text-accent-hover"
          >
            <span class="font-medium">About</span>
            <br />
            <span class="text-xs">Learn about Teesside Digital</span>
          </a>
        </div>
      </div>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button variant="primary" href="/">
          Return Home
        </Button>
        <Button variant="secondary" href="/contact">
          Get in Touch
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  a {
    text-decoration: none;
  }
</style>
