---
/**
 * src/pages/work/[slug].astro
 *
 * Dynamic case study detail pages. One page per project, generated from work.ts data.
 *
 * Route: /work/[slug]
 * Examples: /work/northeast-joinery, /work/quoteflow, /work/siteguard
 *
 * Features:
 * - Detailed case study
 * - Problem statement
 * - Approach & solution
 * - Results
 * - Technical details
 * - CTA to contact
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/astro/Section.astro';
import Button from '@components/astro/Button.astro';
import { getProjects, getProjectBySlug } from '@data/work';
import { getServiceBySlug } from '@data/services';

export function getStaticPaths() {
  const projects = getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ReturnType<typeof getProjectBySlug>;
}

const { project } = Astro.props;

if (!project) {
  return Astro.redirect('/404');
}

const title = `${project.title} - Teesside Digital`;
const description = project.description;
const canonicalURL = new URL(`/work/${project.slug}`, Astro.site);

// Resolve service slugs (e.g. 'web-development') to their real display names
// from services.ts, so this page never duplicates text that could drift out
// of sync with the actual service pages.
const resolvedServices = project.servicesProvided
  .map((slug) => getServiceBySlug(slug)?.title)
  .filter(Boolean);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalURL.href}
>
  <!-- Hero with Project Image -->
  <div class="relative w-full h-96 bg-surface-raised overflow-hidden">
    <img
      src={project.heroImage}
      alt={project.title}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent"></div>
    <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8">
      <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-2">
        {project.title}
      </h1>
      <p class="text-text-secondary">{project.description}</p>
    </div>
  </div>

  <!-- Case Study Content -->
  <Section>
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid md:grid-cols-3 gap-8 md:gap-12">
        <!-- Main Content -->
        <div class="md:col-span-2 space-y-8">
          <!-- The Problem -->
          <div>
            <h2 class="text-2xl font-semibold text-text-primary mb-4">The Problem</h2>
            <p class="text-text-secondary mb-4">{project.challenge}</p>
          </div>

          <!-- Our Approach -->
          <div>
            <h2 class="text-2xl font-semibold text-text-primary mb-4">Our Approach</h2>
            <p class="text-text-secondary">{project.solution}</p>
          </div>

          <!-- The Results -->
          <div>
            <h2 class="text-2xl font-semibold text-text-primary mb-4">The Results</h2>
            {
              project.results && project.results.length > 0 ? (
                <div class="space-y-4">
                  {project.results.map((result) => (
                    <div class="p-4 bg-success/10 border-l-4 border-success rounded">
                      <p class="text-text-secondary text-sm">{result}</p>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="p-4 bg-surface-raised border-l-4 border-warning rounded">
                  <p class="text-text-secondary text-sm">
                    This is a planned demonstration project and hasn't been built yet.
                    Real, measured results will be published here once it's live.
                  </p>
                </div>
              )
            }
          </div>

          <!-- Technical Details -->
          <div>
            <h2 class="text-2xl font-semibold text-text-primary mb-4">
              {project.status === 'live' ? 'Built With' : 'Planned Technology'}
            </h2>
            <ul class="text-text-secondary text-sm space-y-2">
              {project.technologies.map((tech) => (
                <li class="flex gap-2">
                  <span class="text-accent-text">-</span>
                  <span>{tech}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Sidebar: Project Info -->
        <div class="md:col-span-1">
          <div class="sticky top-24 space-y-6">
            <!-- Project Details -->
            <div class="p-6 bg-surface-raised rounded">
              <h3 class="font-semibold text-text-primary mb-4">Project Details</h3>

              <div class="space-y-3 text-sm text-text-secondary">
                <div>
                  <p class="font-medium text-text-primary mb-1">Services</p>
                  <p>{resolvedServices.join(', ')}</p>
                </div>

                <div>
                  <p class="font-medium text-text-primary mb-1">
                    {project.status === 'live' ? 'Built With' : 'Planned Technology'}
                  </p>
                  <p>
                    {
                      Array.isArray(project.technologies)
                        ? project.technologies.join(', ')
                        : project.technologies
                    }
                  </p>
                </div>

                <div>
                  <p class="font-medium text-text-primary mb-1">Timeline</p>
                  <p>8-12 weeks</p>
                </div>

                <div>
                  <p class="font-medium text-text-primary mb-1">Status</p>
                  <span class="inline-block px-3 py-1 bg-success/10 text-success text-xs font-medium rounded">
                    Completed
                  </span>
                </div>
              </div>
            </div>

            <!-- Tags -->
            <div class="p-6 bg-surface-raised rounded">
              <h3 class="font-semibold text-text-primary mb-4">Technologies</h3>
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="text-xs font-medium px-3 py-1 bg-accent/10 text-accent-text rounded">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- CTA -->
            <div class="p-6 bg-accent/10 rounded border border-accent/20">
              <h3 class="font-semibold text-text-primary mb-3">Interested?</h3>
              <p class="text-sm text-text-secondary mb-4">
                Let's discuss how similar solutions could help your business.
              </p>
              <Button variant="primary" size="sm" href="/contact" class="w-full">
                Get in Touch
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Related Projects -->
  <Section background="surface">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <h2 class="text-2xl md:text-3xl font-semibold text-text-primary mb-8">
        View More Projects
      </h2>
      <Button variant="secondary" href="/work">
        See All Case Studies
      </Button>
    </div>
  </Section>
</BaseLayout>
